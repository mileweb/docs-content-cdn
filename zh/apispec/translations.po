#. /paths/~1cdn~1certificates/get/description
msgid ""
"Get a list of available certificates including each certificate's ID, name, "
"version deployed to production, version deployed to staging, the latest "
"version number, when the certificate was last updated, and when the "
"certificate expires. By default, certificates are returned in order of most "
"recently updated first. Use query parameters to filter the list of returned "
"certificates."
msgstr ""

#. /paths/~1cdn~1certificates/get/parameters/0/description
msgid ""
"This parameter specifies a keyword to be searched in the 'name' field of the "
"certificate."
msgstr ""

#. /paths/~1cdn~1certificates/get/parameters/1/description
msgid ""
"The offset indicates the index of the first certificate to return. The "
"default is 0."
msgstr ""

#. /paths/~1cdn~1certificates/get/parameters/2/description
msgid "The limit indicates the maximum number of certificates to return."
msgstr ""

#. /paths/~1cdn~1certificates/get/parameters/3/description
msgid ""
"Filters the results based on where the certificate has been deployed. "
"<table><tr><th>Value</th><th>Effect</th></tr><tr><td></td><td>An empty "
"target parameter results in all certificates being returned whether or not "
"they have been deployed.</td></tr><td>all</td><td>Return all certificates "
"deployed to either staging or production environments.</td></"
"tr><tr><td>staging</td><td>Only return certificates deployed to staging.</"
"td></tr><tr><td>production</td><td>Only return certificates deployed to "
"production.</td></tr></table>\n"
msgstr ""

#. /paths/~1cdn~1certificates/get/parameters/4/description
msgid ""
"Filter results based on auto renewal status. By default, all certificates "
"are returned."
msgstr ""

#. /paths/~1cdn~1certificates/get/parameters/5/description
msgid "Returns certificates sorted by this field."
msgstr ""

#. /paths/~1cdn~1certificates/get/parameters/6/description
msgid ""
"Return results sorted in this order (\"asc\" for ascending order, \"desc\" "
"for descending order).\n"
msgstr ""

#. /paths/~1cdn~1certificates/get/parameters/8/description
msgid ""
"An optional header that resellers can use to specify whether to include data "
"from children customers. <table><tr><th>Value</th><th>Behavior</th></"
"tr><tr><td>self-only</td><td>Include certificates owned by or shared with "
"the caller.</td></tr><tr><td>children-only</td><td>Include certificates "
"owned by or shared with children customers only.</td></"
"tr><tr><td>self+children</td><td>Include certificates owned by or shared "
"with the caller or children customers.</td></tr></table>"
msgstr ""

#. /paths/~1cdn~1certificates/get/parameters/9/description
msgid ""
"By default, only server certificates are returned. Set to <i>true</i> to "
"obtain a list of CA certificates used for client verification instead. Refer "
"to [this page for more about the certificate types](</docs/portal/"
"certificates/overview#overview-of-certificates>)."
msgstr ""

