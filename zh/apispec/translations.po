#. /paths/~1cdn~1prefetches/get/responses/200/content/application~1json/schema/properties/prefetchRequests/items/properties/apiAccountId/description
#. /paths/~1cdn~1prefetches~1{id}/get/responses/200/content/application~1json/schema/properties/metadata/properties/apiAccountId/description
msgid ""
"ID of the API account used to create the prefetch request. This value is "
"only set if the API account was created using our /ngadmin/apiAccounts <a "
"href=\"#operation/post-ngadmin-apiAccounts\">endpoint</a>."
msgstr ""

#. /paths/~1cdn~1prefetches/get/responses/200/content/application~1json/schema/properties/prefetchRequests/items/properties/ownerCustomerId/description
msgid ""
"ID of the customer that made the prefetch request. This field is present "
"only if the Report-Range header is children-only or self+children."
msgstr ""

#. /paths/~1cdn~1prefetches/get/description
msgid ""
"Get a list of prefetch requests. Prefetch records are retained for fifteen "
"days. Filter the list by specifying query parameters."
msgstr ""

#. /paths/~1cdn~1prefetches/get/parameters/0/description
msgid ""
"RFC 3339 date indicating the beginning of the time period. It must be in UTC "
"time, for example, \"2021-03-01T01:00:00Z\"."
msgstr ""

#. /paths/~1cdn~1prefetches/get/parameters/1/description
msgid ""
"RFC 3339 date indicating the end of the time period. It must be in UTC time, "
"for example, \"2021-03-01T01:00:00Z\"."
msgstr ""

#. /paths/~1cdn~1prefetches/get/parameters/2/description
msgid "Index of the first prefetch request to return."
msgstr ""

#. /paths/~1cdn~1prefetches/get/parameters/3/description
msgid "Maximum number of prefetch requests to return."
msgstr ""

#. /paths/~1cdn~1prefetches/get/parameters/4/description
msgid ""
"Controls the order in which prefetch requests are returned. The default is "
"to return the most recently submitted request first."
msgstr ""

#. /paths/~1cdn~1prefetches/get/parameters/5/description
msgid ""
"Order of prefetch requests. The default is to return the most recent "
"prefetch request first. Enter 'asc' for ascending order or 'desc' for "
"descending order."
msgstr ""

#. /paths/~1cdn~1prefetches/get/parameters/6/description
msgid ""
"The value will be used to match on prefetch request names, hostnames, and "
"the task IDs to limit the prefetch requests that are returned."
msgstr ""

#. /paths/~1cdn~1prefetches/get/parameters/7/description
msgid ""
"If you are a reseller, you can use this header to specify the ID of a child "
"customer. Only requests from that customer will be returned. "
msgstr ""

#. /paths/~1cdn~1prefetches/get/parameters/8/description
msgid ""
"An optional header that resellers can use to specify whether to include data "
"from children customers. <table><tr><th>Value</th><th>Behavior</th></"
"tr><tr><td>self-only</td><td>Include prefetch requests by the caller only.</"
"td></tr><tr><td>children-only</td><td>Include prefetch requests by children "
"customers only.</td></tr><tr><td>self+children</td><td>Include prefetch "
"requests by both the caller and children customers.</td></tr></table>"
msgstr ""

#. /paths/~1cdn~1prefetches~1{id}/parameters/0/description
msgid "ID of a prefetch request."
msgstr ""

#. /paths/~1cdn~1prefetches~1{id}/get/summary
msgid "Get prefetch request status"
msgstr ""

#. /paths/~1cdn~1prefetches~1{id}/get/responses/200/description
msgid "The response body contains a summary of the prefetch request."
msgstr ""

#. /paths/~1cdn~1prefetches~1{id}/get/responses/200/content/application~1json/schema/properties/name/description
msgid "A short description of the prefetch task."
msgstr ""

#. /paths/~1cdn~1prefetches~1{id}/get/responses/200/content/application~1json/schema/properties/fileList/items/properties/url/description
msgid ""
"A URL to prefetch. It must begin with 'http' or 'https' and can be up to "
"2048 characters."
msgstr ""

#. /paths/~1cdn~1prefetches~1{id}/get/responses/200/content/application~1json/schema/properties/metadata/description
msgid "Details about the prefetch request's status."
msgstr ""

#. /paths/~1cdn~1prefetches~1{id}/get/responses/200/content/application~1json/schema/properties/metadata/properties/id/description
msgid "ID of the prefetch request."
msgstr ""

#. /paths/~1cdn~1prefetches~1{id}/get/responses/200/content/application~1json/schema/properties/metadata/properties/apiName/description
msgid ""
"Name of API account which created this prefetch request. If a reseller "
"created the request on behalf of a child customer, it is the API account "
"name of the reseller."
msgstr ""

#. /paths/~1cdn~1prefetches~1{id}/get/responses/200/content/application~1json/schema/properties/metadata/properties/customerId/description
msgid "ID of the customer whose URLs are prefetched."
msgstr ""

#. /paths/~1cdn~1prefetches~1{id}/get/responses/200/content/application~1json/schema/properties/metadata/properties/impersonatingParentCustomerId/description
msgid ""
"If a reseller performs a prefetch on behalf of a child customer, this field "
"will be present and indicate the reseller's ID."
msgstr ""

#. /paths/~1cdn~1prefetches~1{id}/get/responses/200/content/application~1json/schema/properties/regions/description
msgid ""
"A list of continents representing the regions in which to perform the "
"prefetch. Omitting the field means the prefetch will be done by all regions' "
"servers. \"Asia\" includes servers in Mainland China."
msgstr ""

#. /paths/~1cdn~1prefetches~1{id}/get/responses/200/content/application~1json/schema/properties/prefetchLevel/description
msgid ""
"CDN Pro servers that will perform the prefetch. The default, <i>Parent</i>, "
"results in parent nodes of the CDN prefetching content."
msgstr ""

#. /paths/~1cdn~1prefetches~1{id}/get/description
msgid "Get details on the status of a prefetch request."
msgstr ""

#. /paths/~1cdn~1apiPermissions/post/summary
msgid "Create an API permission"
msgstr ""

#. /paths/~1cdn~1apiPermissions/post/responses/201/description
msgid ""
"The API permission was successfully created. A Location header containing "
"the URL of the API permissions is returned. Example: <code>Location: https://"
"ngapi.{{siteDomain}}/cdn/apiPermissions/12</code>"
msgstr ""

#. /paths/~1cdn~1apiPermissions/post/responses/201/headers/Location/description
msgid ""
"URL to the API account's permissions. The URL follows this format: https://"
"ngapi.{{siteDomain}}/cdn/apiPermissions/{accountId} where {accountId} "
"represents the ID of the API account. If you would like to get the account "
"ID, simply extract the last portion of the path and ignore the rest.  You "
"can use the ID to create, update, or delete the API permissions."
msgstr ""

#. /paths/~1cdn~1apiPermissions/post/description
msgid ""
"Control which CDN endpoints an <a href=\"#operation/post-ngadmin-"
"apiAccounts\">API account</a> can access. The permissions work with the API "
"account's type, <i>operator</i> or <i>read-only</i>. For example, for "
"security, you can limit a read-only API account to the property management "
"APIs. This would allow the API account to see your property configurations "
"but not make changes to them; it would not be permitted to call other "
"APIs. \n"
"\n"
"You must call this API to create permissions for each new API account before "
"it can be used. After you create a custom API permission for the API "
"account, you can update its permissions further by calling our <a "
"href=\"#operation/patch-cdn-apiPermissions-id\">update permission API</a>."
msgstr ""

#. /paths/~1cdn~1apiPermissions/post/parameters/0/description
msgid ""
"If you are a reseller, you can use this header to specify the ID of a child "
"customer for which you are creating an API permission."
msgstr ""

#. /paths/~1cdn~1apiPermissions/post/requestBody/content/application~1json/schema/properties/allowedOperations/description
#. /paths/~1cdn~1apiPermissions~1{id}/patch/requestBody/content/application~1json/schema/properties/allowedOperations/description
msgid ""
"Customize the access given to the API account. Unspecified fields will be "
"given default values."
msgstr ""

#. /paths/~1cdn~1apiPermissions/post/requestBody/content/application~1json/schema/properties/allowedOperations/properties/certificates/description
#. /paths/~1cdn~1apiPermissions~1{id}/get/responses/200/content/application~1json/schema/properties/allowedOperations/properties/certificates/description
#. /paths/~1cdn~1apiPermissions~1{id}/patch/requestBody/content/application~1json/schema/properties/allowedOperations/properties/certificates/description
msgid ""
"Whether the API account can access the <a href=\"#tag/Certificate-"
"Management\">certificate management</a> (/cdn/certificates) endpoints. The "
"value 'read' can be given to an operator API account to restrict it to "
"getting the list of certificates or a certificate's details."
msgstr ""

#. /paths/~1cdn~1apiPermissions/post/requestBody/content/application~1json/schema/properties/allowedOperations/properties/properties/description
#. /paths/~1cdn~1apiPermissions~1{id}/get/responses/200/content/application~1json/schema/properties/allowedOperations/properties/properties/description
#. /paths/~1cdn~1apiPermissions~1{id}/patch/requestBody/content/application~1json/schema/properties/allowedOperations/properties/properties/description
msgid ""
"Whether the API account can access the <a href=\"#tag/Property-"
"Management\">property management</a> (/cdn/properties) endpoints. The value "
"'read' can be given to an operator API account to restrict it to getting the "
"list of properties or a property's details."
msgstr ""

#. /paths/~1cdn~1apiPermissions/post/requestBody/content/application~1json/schema/properties/allowedOperations/properties/edgeHostnames/description
#. /paths/~1cdn~1apiPermissions~1{id}/get/responses/200/content/application~1json/schema/properties/allowedOperations/properties/edgeHostnames/description
#. /paths/~1cdn~1apiPermissions~1{id}/patch/requestBody/content/application~1json/schema/properties/allowedOperations/properties/edgeHostnames/description
msgid ""
"Whether the API account can access the <a href=\"#tag/Edge-Hostname-"
"Management\">edge hostname management</a> (/cdn/edgeHostnames) endpoints. "
"The value 'read' can be given to an operator API account to restrict it to "
"getting the list of edge hostnames or an edge hostname's details."
msgstr ""

#. /paths/~1cdn~1apiPermissions/post/requestBody/content/application~1json/schema/properties/allowedOperations/properties/validations/description
#. /paths/~1cdn~1apiPermissions~1{id}/patch/requestBody/content/application~1json/schema/properties/allowedOperations/properties/validations/description
msgid ""
"Whether the API account can access the <a href=\"#tag/Property-"
"Validation\">property validation</a> (/cdn/validations) endpoints. The value "
"'read' can be given to an operator API account to restrict it to getting the "
"list of validation tasks or a validation task's details."
msgstr ""

#. /paths/~1cdn~1apiPermissions/post/requestBody/content/application~1json/schema/properties/allowedOperations/properties/deploymentTasks/description
#. /paths/~1cdn~1apiPermissions~1{id}/get/responses/200/content/application~1json/schema/properties/allowedOperations/properties/deploymentTasks/description
#. /paths/~1cdn~1apiPermissions~1{id}/patch/requestBody/content/application~1json/schema/properties/allowedOperations/properties/deploymentTasks/description
msgid ""
"Whether the API account can deploy properties and certificates to staging, "
"production, both staging and production, or not at all using the <a "
"href=\"#tag/Deployment-Management\">deployment management</a> (/cdn/"
"deploymentTasks) endpoints. The value 'read' can be given to an operator API "
"account to restrict it to getting the list of deployment tasks or a "
"deployment task's details."
msgstr ""

#. /paths/~1cdn~1apiPermissions/post/requestBody/content/application~1json/schema/properties/allowedOperations/properties/purges/description
#. /paths/~1cdn~1apiPermissions~1{id}/get/responses/200/content/application~1json/schema/properties/allowedOperations/properties/purges/description
msgid ""
"Whether the API account can access the <a href=\"#operation/"
"createPurge\">purge</a> (/cdn/purges) endpoints. The value 'read' can be "
"given to an operator API account to restrict it to getting the list of purge "
"requests or a purge request's details."
msgstr ""

#. /paths/~1cdn~1apiPermissions/post/requestBody/content/application~1json/schema/properties/allowedOperations/properties/prefetches/description
msgid ""
"Whether the API account can access the <a href=\"#operation/post-cdn-"
"prefetches\">prefetch</a> (/cdn/prefetches) endpoints. The value 'read' can "
"be given to an operator API account to restrict it to getting the list of "
"prefetch requests or a prefetch request's details."
msgstr ""

#. /paths/~1cdn~1apiPermissions/post/requestBody/content/application~1json/schema/properties/allowedOperations/properties/annotations/description
#. /paths/~1cdn~1apiPermissions~1{id}/get/responses/200/content/application~1json/schema/properties/allowedOperations/properties/annotations/description
#. /paths/~1cdn~1apiPermissions~1{id}/patch/requestBody/content/application~1json/schema/properties/allowedOperations/properties/annotations/description
msgid ""
"Whether the API account can access the <a href=\"#tag/Annotations-for-"
"Reports\">report annotations</a> (/cdn/annotations) endpoints. The value "
"'read' can be given to an operator API account to restrict it to getting the "
"list of annotations or an annotation's details."
msgstr ""

#. /paths/~1cdn~1apiPermissions/post/requestBody/content/application~1json/schema/properties/allowedOperations/properties/apiPermissions/description
msgid ""
"Whether the API account can access the <a href=\"#tag/API-Access-"
"Control\">API permission</a> (/cdn/apiPermissions) endpoints. The value "
"'read' can be given to an operator API account to restrict it to getting an "
"API permission's details. An operator API account with this permission set "
"to 'true' cannot, in turn, grant it to another API account under the same "
"customer though it can manage other permissions. A reseller's operator API "
"account could manage this permission on behalf of child customers' API "
"accounts though."
msgstr ""

#. /paths/~1cdn~1apiPermissions/post/requestBody/content/application~1json/schema/properties/allowedOperations/properties/systemConfigs/description
#. /paths/~1cdn~1apiPermissions~1{id}/get/responses/200/content/application~1json/schema/properties/allowedOperations/properties/systemConfigs/description
#. /paths/~1cdn~1apiPermissions~1{id}/patch/requestBody/content/application~1json/schema/properties/allowedOperations/properties/systemConfigs/description
msgid ""
"Whether the API account can access the <a href=\"#operation/get-cdn-"
"systemConfigs\">system configuration</a> (/cdn/systemConfigs) endpoint."
msgstr ""

#. /paths/~1cdn~1apiPermissions/post/requestBody/content/application~1json/schema/properties/allowedOperations/properties/reports/description
#. /paths/~1cdn~1apiPermissions~1{id}/get/responses/200/content/application~1json/schema/properties/allowedOperations/properties/reports/description
#. /paths/~1cdn~1apiPermissions~1{id}/patch/requestBody/content/application~1json/schema/properties/allowedOperations/properties/reports/description
