#. /paths/~1cdn~1prefetches/post/summary
msgid "Create a prefetch request"
msgstr ""

#. /paths/~1cdn~1prefetches/post/responses/201/description
msgid ""
"The prefetch request was successfully created. The <i>Location</i> header "
"includes a reference to the prefetch request.  Call the <a href=\"#operation/"
"get-cdn-prefetches-id\">Get Prefetch Request status API</a> to check its "
"status. Example, <code>Location: https://ngapi.{{siteDomain}}/cdn/prefetches/"
"e91e8674-c2c5-4440-a1de-8b2ea99293dd</code>."
msgstr ""

#. /paths/~1cdn~1prefetches/post/responses/201/headers/Location/description
msgid ""
"URL representing the new prefetch request. The URL follows this format: "
"https://ngapi.{{siteDomain}}/cdn/prefetches/{prefetchId} where {prefetchId} "
"represents the ID of the newly created prefetch request. If you would like "
"to get the request ID, simply extract the last portion of the path and "
"ignore the rest. "
msgstr ""

#. /paths/~1cdn~1prefetches/post/responses/400/content/application~1json/schema/properties/code/description
msgid "An error code."
msgstr ""

#. /paths/~1cdn~1prefetches/post/responses/400/content/application~1json/schema/properties/message/description
msgid "An error message."
msgstr ""

#. /paths/~1cdn~1prefetches/post/description
msgid ""
"Create a prefetch request to warm up the CDN Pro cache with contents from "
"your origin in anticipation of visitors. This is helpful to prevent a sudden "
"influx of requests to your origin servers. The URLs you prefetch must be for "
"hostnames of properties deployed to production.\n"
msgstr ""

#. /paths/~1cdn~1prefetches/post/requestBody/content/application~1json/schema/properties/name/description
msgid "Enter a short description of the prefetch task."
msgstr ""

#. /paths/~1cdn~1prefetches/post/requestBody/content/application~1json/schema/properties/fileList/description
#. /paths/~1cdn~1prefetches~1{id}/get/responses/200/content/application~1json/schema/properties/fileList/description
msgid "URLs to prefetch."
msgstr ""

#. /paths/~1cdn~1prefetches/post/requestBody/content/application~1json/schema/properties/fileList/items/properties/url/description
msgid ""
"A URL to prefetch. It must begin with 'http' or 'https' and can be up to "
"2048 characters.\n"
msgstr ""

#. /paths/~1cdn~1prefetches/post/requestBody/content/application~1json/schema/properties/fileList/items/properties/headers/description
#. /paths/~1cdn~1prefetches~1{id}/get/responses/200/content/application~1json/schema/properties/fileList/items/properties/headers/description
msgid ""
"If a URL's cache key depends on request headers, you can specify the header "
"values that are applicable to prefetch one version of the URL."
msgstr ""

#. /paths/~1cdn~1prefetches/post/requestBody/content/application~1json/schema/properties/regions/description
msgid ""
"A list of regions in which to perform the prefetch. Omitting the field means "
"the prefetch will be done by all regions' servers. \"Asia\" includes servers "
"in Mainland China."
msgstr ""

#. /paths/~1cdn~1prefetches/post/requestBody/content/application~1json/schema/properties/startTime/description
#. /paths/~1cdn~1prefetches~1{id}/get/responses/200/content/application~1json/schema/properties/startTime/description
msgid ""
"RFC 3339 date indicating when the prefetch should begin. This must be in UTC "
"time, for example, \"2021-03-06T00:00:00Z\"."
msgstr ""

#. /paths/~1cdn~1prefetches/post/requestBody/content/application~1json/schema/properties/webhook/description
#. /paths/~1cdn~1prefetches~1{id}/get/responses/200/content/application~1json/schema/properties/webhook/description
msgid "ID of a webhook to call when the prefetch task completes."
msgstr ""

#. /paths/~1cdn~1prefetches/post/requestBody/description
msgid "Specify the URLs you wish to prefetch."
msgstr ""

#. /paths/~1cdn~1prefetches/get/summary
msgid "Get list of prefetch requests"
msgstr ""

#. /paths/~1cdn~1prefetches/get/responses/200/description
msgid "The response contains a list of prefetch requests."
msgstr ""

#. /paths/~1cdn~1prefetches/get/responses/200/content/application~1json/schema/properties/count/description
msgid ""
"Total number of prefetch requests matching the criteria specified in the "
"query parameters. The actual number of entries in prefetchRequests may be "
"fewer if you specified the parameter."
msgstr ""

#. /paths/~1cdn~1prefetches/get/responses/200/content/application~1json/schema/properties/prefetchRequests/description
