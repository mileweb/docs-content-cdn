#. (+1 more)
msgid ""
"The idType field indicates a type of ID for the customer. Its value must be "
"specified in the idNumber field.\n"
"<table>\n"
"<tr><th>idType </th><th>Description</th></tr>\n"
"<tr><td>1</td><td>business license number</td></tr>\n"
"<tr><td>2</td><td>ID card</td></tr>\n"
"<tr><td>3</td><td>license of organization code</td></tr>\n"
"<tr><td>4</td><td>certificate of business corporation</td></tr>\n"
"<tr><td>5</td><td>army code</td></tr>\n"
"<tr><td>6</td><td>social group legal person certificate</td></tr>\n"
"<tr><td>7</td><td>passport</td></tr>\n"
"<tr><td>8</td><td>military ID</td></tr>\n"
"<tr><td>9</td><td>mainland travel permit for Taiwan residents</td></tr>\n"
"<tr><td>999</td><td>others</td></tr>\n"
"</table>"
