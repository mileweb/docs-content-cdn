"you will need to set the <i>hasBeian</i> field to <i>true</i> and also "
"indicate the type of content you are distributing. Enter the value that best "
"corresponds to your content:\n"
"\n"
"<table>\n"
"<tr><th>Value</th><th>Content Type</th></tr>\n"
"<tr><td>1</td><td>Instant Messaging</td></tr>\n"
"<tr><td>2</td><td>Search Engine</td></tr>\n"
"<tr><td>3</td><td>Web Portal</td></tr>\n"
"<tr><td>4</td><td>Online Postal Service</td></tr>\n"
"<tr><td>5</td><td>Online News</td></tr>\n"
"<tr><td>6</td><td>Blog</td></tr>\n"
"<tr><td>7</td><td>Advertisement</td></tr>\n"
"<tr><td>8</td><td>Organization Web Portal</td></tr>\n"
"<tr><td>9</td><td>Shopping</td></tr>\n"
"<tr><td>10</td><td>Online Payment</td></tr>\n"
"<tr><td>11</td><td>Online Bank</td></tr>\n"
"<tr><td>12</td><td>Online Stock Market</td></tr>\n"
"<tr><td>13</td><td>Online Gaming</td></tr>\n"
"<tr><td>14</td><td>Online Music</td></tr>\n"
"<tr><td>15</td><td>Online Movie</td></tr>\n"
"<tr><td>16</td><td>Online Picture</td></tr>\n"
"<tr><td>17</td><td>Software Download</td></tr>\n"
"<tr><td>18</td><td>Job Hunting</td></tr>\n"
"<tr><td>19</td><td>Online Dating</td></tr>\n"
"<tr><td>20</td><td>Online Real Property</td></tr>\n"
"<tr><td>21</td><td>Online Education</td></tr>\n"
"<tr><td>22</td><td>Web Design</td></tr>\n"
"<tr><td>23</td><td>WAP</td></tr>\n"
"<tr><td>24</td><td>Others</td></tr>\n"
"</table>"
msgstr ""

#. /paths/~1cdn~1properties~1{propertyID}~1versions~1{version}/get/responses/200/content/application~1json/schema/properties/configs/properties/origins/description
#. /paths/~1cdn~1properties~1{propertyID}~1versions~1{version}/patch/requestBody/content/application~1json/schema/properties/origins/description
