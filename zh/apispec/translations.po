"<tr><th>Value</th><th>Language</th></tr>\n"
"<tr><td>en</td><td>English</td></tr>\n"
"<tr><td>cn</td><td>Chinese</td></tr>\n"
"<tr><td>jp</td><td>Japanese</td></tr>\n"
"<tr><td>kr</td><td>Korean</td></tr>\n"
"</table>"
msgstr ""

#. /paths/~1ngadmin~1customers~1{id}/get/responses/200/content/application~1json/schema/properties/emailAddress/description
#. /paths/~1ngadmin~1customers~1{id}/patch/responses/200/content/application~1json/schema/properties/emailAddress/description
#. /paths/~1ngadmin~1customers/post/requestBody/content/application~1json/schema/properties/emailAddress/description
