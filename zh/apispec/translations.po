#. /paths/~1cdn~1webhooks~1{id}/patch/requestBody/content/application~1json/schema/properties/credentials/properties/secretKey/description
msgid ""
"A string that is encoded with the date and passed in the Authorization "
"header to your server."
msgstr ""

