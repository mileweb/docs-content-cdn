"<a href=\"#operation/createPurge\">purge request</a>."
msgstr ""

#. /paths/~1cdn~1serviceQuotas/post/requestBody/content/application~1json/schema/properties/maxDirPurgeEntries/description
#. /paths/~1cdn~1serviceQuotas~1{serviceQuotaId}/get/responses/200/content/application~1json/schema/properties/maxDirPurgeEntries/description
