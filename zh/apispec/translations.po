#. /paths/~1cdn~1report~1edgeHostnameReqSummary/get/responses/200/content/application~1json/schema/properties/metaData/properties/dataNames/description
msgid "Indicates the type of data returned: \"edgeHostname dns request\""
msgstr ""

#. /paths/~1cdn~1report~1edgeHostnameReqSummary/post/responses/200/content/application~1json/schema/properties/groups/description
#. /paths/~1cdn~1report~1edgeHostnameReqSummary/get/responses/200/content/application~1json/schema/properties/groups/description
msgid ""
"This object contains the breakdown of DNS requests by group. Groups are "
"determined by the request body."
msgstr ""

#. /paths/~1cdn~1report~1edgeHostnameReqSummary/post/responses/200/content/application~1json/schema/properties/groups/items/properties/group/description
#. /paths/~1cdn~1report~1edgeHostnameReqSummary/get/responses/200/content/application~1json/schema/properties/groups/items/properties/group/description
