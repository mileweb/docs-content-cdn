#. /paths/~1cdn~1serviceQuotas/post/requestBody/content/application~1json/schema/properties/allowedLbDirectives/description
#. /paths/~1cdn~1serviceQuotas~1{serviceQuotaId}/get/responses/200/content/application~1json/schema/properties/allowedLbDirectives/description
#. /paths/~1cdn~1serviceQuotas~1{serviceQuotaId}/patch/requestBody/content/application~1json/schema/properties/allowedLbDirectives/description
#. (+3 more)
msgid ""
"A list of advanced Edge Logic directives that can be used in the "
"loadBalancerLogic field of a property in addition to the set of basic load "
"balancer directives listed in the  <a href=\"#operation/get-cdn-"
"systemConfigs\">system configuration API</a>. If you require an advanced "
"load balancer directive, please contact our support team."
msgstr ""

#. /paths/~1cdn~1serviceQuotas/post/requestBody/content/application~1json/schema/properties/allowedServerGroups/description
msgid ""
"List of server groups the customer is permitted to use. This can be used to "
"balance performance and cost. Access to a higher level server group includes "
"access to lower level groups. In particular, <i>ultra</i> includes "
"<i>standard</i>, <i>premium</i>, and <i>deluxe</i>; <i>deluxe</i> includes "
"<i>premium</i> and <i>standard</i>; <i>premium</i> includes <i>standard</i>; "
"and <i>ChinaPremium</i> includes <i>ChinaStandard</i>."
msgstr ""

#. /paths/~1cdn~1serviceQuotas/post/requestBody/content/application~1json/schema/properties/privateDomains/description
#. /paths/~1cdn~1serviceQuotas~1{serviceQuotaId}/get/responses/200/content/application~1json/schema/properties/privateDomains/description
#. /paths/~1cdn~1serviceQuotas~1{serviceQuotaId}/patch/requestBody/content/application~1json/schema/properties/privateDomains/description
#. (+3 more)
msgid ""
"List of domains that the customer owns. Only this customer can create "
"properties specifying these domains in the hostnames field. "
msgstr ""

#. /paths/~1cdn~1serviceQuotas/post/requestBody/description
msgid "The request body contains the service quota settings for the customer."
msgstr ""

#. /paths/~1cdn~1serviceQuotas/get/summary
msgid "Get a list of service quotas"
msgstr ""

#. /paths/~1cdn~1serviceQuotas/get/responses/200/description
msgid "The response contains a list of service quotas."
msgstr ""

#. /paths/~1cdn~1serviceQuotas/get/responses/200/content/application~1json/schema/properties/count/description
msgid ""
"Total number of service quota entries available. The number returned in "
"serviceQuotaList may be fewer as it is limited to 200 entries."
msgstr ""

#. /paths/~1cdn~1serviceQuotas/get/responses/200/content/application~1json/schema/properties/serviceQuotaList/description
msgid "A list of up to 200 service quota summaries."
msgstr ""

#. /paths/~1cdn~1serviceQuotas/get/responses/200/content/application~1json/schema/properties/serviceQuotaList/items/description
msgid "Summarizes service quotas for a customer."
msgstr ""

#. /paths/~1cdn~1serviceQuotas/get/responses/200/content/application~1json/schema/properties/serviceQuotaList/items/properties/id/description
msgid ""
"A service quota ID. You can use this to <a href=\"#operation/get-cdn-"
"serviceQuotas-serviceQuotaId\">get more details about the service quota</a>."
msgstr ""

#. /paths/~1cdn~1serviceQuotas/get/responses/200/content/application~1json/schema/properties/serviceQuotaList/items/properties/status/description
msgid ""
"Indicates the status of access to the CDN Pro product.  An <i>active</i> "
"customer has full access. A <i>suspended</i> customer no longer has access. "
"A <i>trial</i> customer is one with trial settings which may be more limited "
"than those of a customer with the <i>active</i> status."
msgstr ""

#. /paths/~1cdn~1serviceQuotas/get/responses/200/content/application~1json/schema/properties/serviceQuotaList/items/properties/trialDeadline/description
#. /paths/~1cdn~1serviceQuotas~1{serviceQuotaId}/patch/requestBody/content/application~1json/schema/properties/trialDeadline/description
#. /paths/~1cdn~1serviceQuotas~1customer~1{customerId}/patch/requestBody/content/application~1json/schema/properties/trialDeadline/description
msgid ""
"A date in RFC 3339 format indicating when the trial expires. This field is "
"required if the <i>status</i> field's value is <i>trial</i>."
msgstr ""

#. /paths/~1cdn~1serviceQuotas/get/responses/200/content/application~1json/schema/properties/serviceQuotaList/items/properties/usageLimitDays/description
#. /paths/~1cdn~1serviceQuotas~1{serviceQuotaId}/get/responses/200/content/application~1json/schema/properties/usageLimitDays/description
#. /paths/~1cdn~1serviceQuotas~1customer~1{customerId}/get/responses/200/content/application~1json/schema/properties/usageLimitDays/description
#. (+1 more)
msgid ""
"This setting applies to trial customers. It is used to limit traffic use. It "
"represents the number of days over which the traffic amount designated by "
"the <i>usageLimitDollar</i> field can be used. For example, a value of 90 "
"for <i>usageLimitDays</i> and 50 for <i>usageLimitDollar</i> means the "
"customer can use up to $50 worth of total traffic over 90 day period.\n"
msgstr ""

#. /paths/~1cdn~1serviceQuotas/get/responses/200/content/application~1json/schema/properties/serviceQuotaList/items/properties/usageLimitDollar/description
#. /paths/~1cdn~1serviceQuotas~1{serviceQuotaId}/get/responses/200/content/application~1json/schema/properties/usageLimitDollar/description
#. /paths/~1cdn~1serviceQuotas~1customer~1{customerId}/get/responses/200/content/application~1json/schema/properties/usageLimitDollar/description
#. (+1 more)
msgid ""
"This setting applies to trial customers. It represents the amount of traffic "
"valued in US dollars that is permitted to be used over a period of time  set "
"by the <i>usageLimitDays</i> field. For example, a value of 90 for "
"<i>usageLimitDays</i> and 50 for <i>usageLimitDollar</i> means the customer "
"can use up to $50 worth of total traffic over 90 day period. The dollar "
"value is based on CDN Pro's default pricing.\n"
msgstr ""

#. /paths/~1cdn~1serviceQuotas/get/responses/200/content/application~1json/schema/properties/serviceQuotaList/items/properties/creationTime/description
msgid "RFC 3339 date indicate when the service quota was created."
msgstr ""

#. /paths/~1cdn~1serviceQuotas/get/responses/200/content/application~1json/schema/properties/serviceQuotaList/items/properties/lastUpdateTime/description
#. /paths/~1cdn~1serviceQuotas~1{serviceQuotaId}/get/responses/200/content/application~1json/schema/properties/lastUpdateTime/description
#. /paths/~1cdn~1serviceQuotas~1customer~1{customerId}/get/responses/200/content/application~1json/schema/properties/lastUpdateTime/description
#. (+1 more)
msgid "RFC 3339 date indicating when the service quota was last updated."
msgstr ""

#. /paths/~1cdn~1serviceQuotas/get/description
msgid ""
"<b>Resellers</b> can use this API to obtain a list of service quotas of "
"their child customers. Optional query parameters let you filter the results."
msgstr ""

#. /paths/~1cdn~1serviceQuotas/get/parameters/1/description
msgid ""
"An optional header that resellers can use to specify whether to include data "
"from children customers. <table><tr><th>Value</th><th>Behavior</th></"
"tr><tr><td>self-only</td><td>Return service quota of the caller only.</td></"
"tr><tr><td>children-only</td><td>Include service quotas of children "
"customers only.</td></tr><tr><td>self+children</td><td>Include service "
"quotas of both the caller and children customers.</td></tr></table>"
msgstr ""

#. /paths/~1cdn~1serviceQuotas/get/parameters/2/description
msgid ""
"Return service quotas with a particular status. By default, all service "
"quotas are returned."
msgstr ""

#. /paths/~1cdn~1serviceQuotas/get/parameters/3/description
msgid ""
"Return service quotas depending on whether the customer is permitted to "
"deploy to production or not. By default, all are returned regardless."
msgstr ""

#. /paths/~1cdn~1serviceQuotas/get/parameters/4/description
msgid ""
"If the parameter is specified, return service quotas where both "
"usageLimitDays and usageLimitDollar have non-zero values. The actual "
"parameter value is ignored."
msgstr ""

#. /paths/~1cdn~1serviceQuotas/get/parameters/5/description
msgid ""
"Return service quotas of customers permitted to use an advanced [Edge Logic "
"directive](</docs/edge-logic/supported-directives#expires>) specified by "
"this parameter."
msgstr ""

#. /paths/~1cdn~1serviceQuotas/get/parameters/6/description
msgid "Return service quotas whose accountManagerEmail matches this value."
msgstr ""

#. /paths/~1cdn~1serviceQuotas/get/parameters/7/description
msgid "Index of the first service quota to return."
msgstr ""

#. /paths/~1cdn~1serviceQuotas/get/parameters/8/description
msgid "Maximum number of service quotas to return. "
msgstr ""

#. /paths/~1cdn~1serviceQuotas/get/parameters/9/description
msgid ""
"Specify an advanced feature to search for. Only service quotas with the "
"feature enabled will be returned."
msgstr ""

#. /paths/~1cdn~1serviceQuotas/get/parameters/10/description
msgid ""
"Specify a value to search for among the values of the "
"allowedCacheDirectives, allowedLbDirectives, allowedServerGroups, and "
"advancedFeatures fields. Only service quotas which include the value will be "
"returned."
msgstr ""

#. /paths/~1cdn~1serviceQuotas~1{serviceQuotaId}/parameters/0/description
msgid ""
"Specify the service quota ID. It is returned when <a href=\"#operation/post-"
"cdn-serviceQuotas\">creating a service quota</a>."
msgstr ""

#. /paths/~1cdn~1serviceQuotas~1{serviceQuotaId}/get/summary
msgid "Get a service quota by service quota ID"
msgstr ""

