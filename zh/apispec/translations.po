#. /paths/~1cdn~1edgeHostnames~1{edgeHostname}/get/responses/200/content/application~1json/schema/properties/history/items/properties/configuration/properties/edgeHostname/description
#. /paths/~1cdn~1edgeHostnames~1{edgeHostname}/get/responses/200/content/application~1json/schema/properties/configs/properties/edgeHostname/description
#. /paths/~1cdn~1edgeHostnames/get/responses/200/content/application~1json/schema/properties/edgeHostnames/items/properties/edgeHostname/description
