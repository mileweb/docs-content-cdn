#. /paths/~1ngadmin~1contacts/post/requestBody/content/application~1json/schema/properties/address/description
#. /paths/~1ngadmin~1customers~1{id}/get/responses/200/content/application~1json/schema/properties/address/description
#. /paths/~1ngadmin~1customers~1{id}/patch/responses/200/content/application~1json/schema/properties/address/description
#. (+3 more)
msgid "Describes a physical address."
msgstr "描述一个实际地址。"

#. /paths/~1ngadmin~1contacts/post/requestBody/content/application~1json/schema/properties/address/properties/line1/description
#. /paths/~1ngadmin~1contacts~1{id}/get/responses/200/content/application~1json/schema/properties/address/properties/line1/description
#. /paths/~1ngadmin~1contacts~1{id}/patch/requestBody/content/application~1json/schema/properties/address/properties/line1/description
#. (+5 more)
msgid "First line of the address."
msgstr "地址的第一行。"

#. /paths/~1ngadmin~1contacts/post/requestBody/content/application~1json/schema/properties/address/properties/line2/description
#. /paths/~1ngadmin~1contacts~1{id}/get/responses/200/content/application~1json/schema/properties/address/properties/line2/description
#. /paths/~1ngadmin~1contacts~1{id}/patch/requestBody/content/application~1json/schema/properties/address/properties/line2/description
#. (+5 more)
msgid "Second line of the address."
msgstr "地址的第二行。"

#. /paths/~1ngadmin~1contacts/post/requestBody/content/application~1json/schema/properties/address/properties/zipCode/description
#. /paths/~1ngadmin~1customers~1{id}/get/responses/200/content/application~1json/schema/properties/address/properties/zipCode/description
#. /paths/~1ngadmin~1customers~1{id}/patch/responses/200/content/application~1json/schema/properties/address/properties/zipCode/description
#. (+3 more)
msgid "A postal or zip code."
msgstr "邮政编码。"

#. /paths/~1ngadmin~1contacts/post/requestBody/content/application~1json/schema/properties/address/properties/country/description
#. /paths/~1ngadmin~1customers~1{id}/get/responses/200/content/application~1json/schema/properties/address/properties/country/description
#. /paths/~1ngadmin~1customers~1{id}/patch/responses/200/content/application~1json/schema/properties/address/properties/country/description
#. (+3 more)
msgid "A country."
msgstr "国家/地区。"

#. /paths/~1ngadmin~1contacts/post/requestBody/content/application~1json/schema/properties/configs/title
#. /paths/~1ngadmin~1contacts~1{id}/get/responses/200/content/application~1json/schema/properties/configs/title
#. /paths/~1ngadmin~1contacts~1{id}/patch/requestBody/content/application~1json/schema/properties/configs/title
msgid "portal user configurations"
msgstr "控制台用户配置"

#. /paths/~1ngadmin~1contacts/post/requestBody/content/application~1json/schema/properties/configs/description
#. /paths/~1ngadmin~1contacts~1{id}/get/responses/200/content/application~1json/schema/properties/configs/description
#. /paths/~1ngadmin~1contacts~1{id}/patch/requestBody/content/application~1json/schema/properties/configs/description
msgid ""
"Contains settings that control the level of access given to the portal user."
msgstr "包含控制该控制台用户访问权限级别的设置。"

#. /paths/~1ngadmin~1contacts/post/requestBody/content/application~1json/schema/properties/configs/properties/isMaster/description
#. /paths/~1ngadmin~1contacts/get/responses/200/content/application~1json/schema/properties/contacts/items/properties/isMaster/description
#. /paths/~1ngadmin~1contacts~1{id}/get/responses/200/content/application~1json/schema/properties/configs/properties/isMaster/description
#. (+1 more)
msgid ""
"Indicates whether this portal user has full access to all subscribed "
"products."
msgstr "表示该控制台用户是否拥有所有已订阅产品的完全访问权限。"

#. /paths/~1ngadmin~1contacts/post/requestBody/content/application~1json/schema/properties/configs/properties/products/description
#. /paths/~1ngadmin~1contacts~1{id}/get/responses/200/content/application~1json/schema/properties/configs/properties/products/description
#. /paths/~1ngadmin~1contacts~1{id}/patch/requestBody/content/application~1json/schema/properties/configs/properties/products/description
msgid ""
"List of products that the user has access to. The default is no products. "
"You can specify \"CDN\" to represent CDN Pro, and \"HDT\" for High-Speed "
"Data Transmission. This field is ignored for master contacts, as a master "
"contact has access to all subscribed products."
msgstr ""
"该用户有权访问的产品列表。默认不包含任何产品。您可以指定 \"CDN\" 表示 CDN "
"Pro，指定 \"HDT\" 表示 High-Speed Data Transmission。对于主联系人，此字段会被"
"忽略，因为主联系人有权访问所有已订阅的产品。"

#. /paths/~1ngadmin~1contacts/post/requestBody/content/application~1json/schema/properties/configs/properties/canImpersonate/description
#. /paths/~1ngadmin~1contacts~1{id}/get/responses/200/content/application~1json/schema/properties/configs/properties/canImpersonate/description
#. /paths/~1ngadmin~1contacts~1{id}/patch/requestBody/content/application~1json/schema/properties/configs/properties/canImpersonate/description
msgid ""
"This setting applies to resellers only. It indicates whether the user can "
"impersonate child customers. A value of \"all\" means the user can "
"impersonate all child customers. A value of \"none\" means the user cannot "
"impersonate any. This field works with the <i>impersonateExceptions</i> "
"field."
msgstr ""
"此设置仅适用于代理商。表示该用户是否可以模拟子客户。值为 \"all\" 表示该用户可"
"以模拟所有子客户；值为 \"none\" 表示该用户不能模拟任何子客户。此字段与 "
"<i>impersonateExceptions</i> 字段配合使用。"

#. /paths/~1ngadmin~1contacts/post/requestBody/content/application~1json/schema/properties/configs/properties/status/description
#. /paths/~1ngadmin~1contacts~1{id}/get/responses/200/content/application~1json/schema/properties/configs/properties/status/description
#. /paths/~1ngadmin~1contacts~1{id}/patch/requestBody/content/application~1json/schema/properties/configs/properties/status/description
msgid ""
"Indicates the status of the portal user account. An 'active' user has full "
"access to the portal. A 'suspended' user cannot log in.  A 'pending' user is "
"one that has been invited to use the portal but has not completed setting up "
"the account.  You cannot call the <a href=\"/apidocs/portal-user-management/"
"createcontact\">Create a  portal user</a> or <a href=\"/apidocs/portal-user-"
"management/patch-ngadmin-contacts-id\">Update a portal user</a> APIs with a "
"status value of 'pending'."
msgstr ""
"表示控制台用户账号的状态。'active' 用户拥有控制台的完全访问权限。'suspended' "
"用户无法登录。'pending' 用户是指已被邀请使用控制台但尚未完成账号设置的用户。"
"调用<a href=\"/apidocs/portal-user-management/createcontact\">创建控制台用户"
"</a>或<a href=\"/apidocs/portal-user-management/patch-ngadmin-contacts-id\">"
"修改控制台用户</a> API 时，status 的值不能为 'pending'。"

#. /paths/~1ngadmin~1contacts/post/requestBody/content/application~1json/schema/properties/configs/properties/impersonateExceptions/description
#. /paths/~1ngadmin~1contacts~1{id}/get/responses/200/content/application~1json/schema/properties/configs/properties/impersonateExceptions/description
#. /paths/~1ngadmin~1contacts~1{id}/patch/requestBody/content/application~1json/schema/properties/configs/properties/impersonateExceptions/description
msgid ""
"This setting applies to resellers only.  It contains a list of customer IDs "
"that are exceptions to the rule defined by the <i>canImpersonate</i> field. "
"For example, if <i>canImpersonate</i> is \"all\" the portal user can "
"impersonate all child customers of the reseller. Entering one or more "
"customer IDs as exceptions will prevent the user from impersonating those "
"particular child customers. Conversely, if <i>canImpersonate</i> is "
"\"none\", entries in the exception list represent customers who can be "
"impersonated by this user."
msgstr ""
"此设置仅适用于代理商。它包含一个客户 ID 列表，这些客户是 <i>canImpersonate</"
"i> 字段所定义规则的例外。例如，如果 <i>canImpersonate</i> 为 \"all\"，则该控"
"制台用户可以模拟代理商的所有子客户；输入一个或多个客户 ID 作为例外，将阻止该"
"用户模拟这些特定的子客户。反之，如果 <i>canImpersonate</i> 为 \"none\"，则例"
"外列表中的条目表示该用户可以模拟的客户。"

#. /paths/~1ngadmin~1contacts/post/requestBody/content/application~1json/schema/properties/configs/properties/ipWhiteList/description
#. /paths/~1ngadmin~1contacts~1{id}/get/responses/200/content/application~1json/schema/properties/configs/properties/ipWhiteList/description
#. /paths/~1ngadmin~1contacts~1{id}/patch/requestBody/content/application~1json/schema/properties/configs/properties/ipWhiteList/description
msgid ""
"List of IP addresses from which the portal user can log in. This list "
"applies in addition to the portalSettings.ipWhiteList's addresses you can <a "
"href=\"/apidocs/customer-management/patch-ngadmin-customers-id\">set up at "
"the customer level.</a> You can specify a range, an individual IP address, "
"or an IP in CIDR notation. Compressed and uncompressed IPv6 addresses are "
"also permitted. Example: <code>[\\\"1.1.1.1-1.1.1.8\\\", \\\"1.2.3.4\\\", \\"
"\"1.5.5.0/24\\\"]</code>"
msgstr ""
"允许该控制台用户从中登录的 IP 地址列表。此列表是在您可以<a href=\"/apidocs/"
"customer-management/patch-ngadmin-customers-id\">在客户级别设置的</a> "
"portalSettings.ipWhiteList 地址之外额外生效的。您可以指定一个范围、单个 IP 地"
"址或 CIDR 表示法的 IP。也允许使用压缩和非压缩格式的 IPv6 地址。示例："
"<code>[\\\"1.1.1.1-1.1.1.8\\\", \\\"1.2.3.4\\\", \\\"1.5.5.0/24\\\"]</code>"

#. /paths/~1ngadmin~1contacts/post/requestBody/content/application~1json/schema/properties/language/description
#. /paths/~1ngadmin~1contacts~1{id}/patch/requestBody/content/application~1json/schema/properties/language/description
msgid ""
"The user's preferred language. It is a two character value representing "
"English (en), Chinese (cn), Korean (kr), Japanese (jp), Russian (ru), or "
"French (fr)."
msgstr ""
"用户的首选语言。它是一个两字符的值，表示英语 (en)、中文 (cn)、韩语 (kr)、日"
"语 (jp)、俄语 (ru) 或法语 (fr)。"

#. /paths/~1ngadmin~1contacts/post/requestBody/content/application~1json/schema/properties/department/description
#. /paths/~1ngadmin~1contacts~1{id}/patch/requestBody/content/application~1json/schema/properties/department/description
msgid "User's department."
msgstr "用户所在的部门。"

#. /paths/~1ngadmin~1contacts/post/requestBody/content/application~1json/schema/properties/linkedAccount/description
#. /paths/~1ngadmin~1contacts~1{id}/get/responses/200/content/application~1json/schema/properties/linkedAccount/description
#. /paths/~1ngadmin~1contacts~1{id}/patch/requestBody/content/application~1json/schema/properties/linkedAccount/description
msgid "ID of an external account that this portal user maps to."
msgstr "该控制台用户所映射的外部账号的 ID。"

#. /paths/~1ngadmin~1contacts/post/requestBody/description
msgid "Specify information about the new portal user."
msgstr "指定新控制台用户的信息。"

#. /paths/~1ngadmin~1contacts/post/parameters/0/description
msgid ""
"If you are a reseller, you can use this header to specify the ID of a child "
"customer. This will result in a new user account being created for the child "
"customer."
msgstr ""
"如果您是代理商，可以使用此请求头指定子客户的 ID。这样将为该子客户创建新的用户"
"账号。"

#. /paths/~1ngadmin~1contacts/get/summary
msgid "Get list of portal user accounts"
msgstr "获取控制台用户账号列表"

#. /paths/~1ngadmin~1contacts/get/responses/200/description
msgid "The response body contains a list of portal users."
msgstr "响应体包含控制台用户列表。"

#. /paths/~1ngadmin~1contacts/get/responses/200/content/application~1json/schema/properties/count/description
msgid ""
"Total number of users. If you choose to filter the results, the total will "
"include the filtered users as well as the users returned in the response."
msgstr ""
"用户总数。如果您选择过滤结果，该总数将同时包含被过滤掉的用户和响应中返回的用"
"户。"

#. /paths/~1ngadmin~1contacts/get/responses/200/content/application~1json/schema/properties/contacts/description
msgid "List of users."
msgstr "用户列表。"

#. /paths/~1ngadmin~1contacts/get/responses/200/content/application~1json/schema/properties/contacts/items/properties/id/description
msgid "ID of the user."
msgstr "用户的 ID。"

#. /paths/~1ngadmin~1contacts/get/responses/200/content/application~1json/schema/properties/contacts/items/properties/lastName/description
msgid "Last name of the user.\n"
msgstr "用户的姓氏。\n"

#. /paths/~1ngadmin~1contacts/get/responses/200/content/application~1json/schema/properties/contacts/items/properties/loginName/description
msgid "Portal login name."
msgstr "控制台登录名。"

#. /paths/~1ngadmin~1contacts/get/responses/200/content/application~1json/schema/properties/contacts/items/properties/emailAddress/description
#. /paths/~1ngadmin~1contacts~1{id}/patch/requestBody/content/application~1json/schema/properties/emailAddress/description
msgid "Email address of the user."
msgstr "用户的电子邮件地址。"

#. /paths/~1ngadmin~1contacts/get/responses/200/content/application~1json/schema/properties/contacts/items/properties/status/description
msgid ""
"Indicates the status of the account. An account can be <i>active</i>, which "
"means login is allowed; <i>pending</i>, which means the user has been "
"invited to use the portal but has not completed account setup; or "
"<i>suspended</i>, which prevents logins."
msgstr ""
"表示账号的状态。账号可以是 <i>active</i>，表示允许登录；<i>pending</i>，表示"
"用户已被邀请使用控制台但尚未完成账号设置；或 <i>suspended</i>，表示禁止登录。"

#. /paths/~1ngadmin~1contacts/get/responses/200/content/application~1json/schema/properties/contacts/items/properties/creationTime/description
msgid "RFC 3339 date indicating when the user account was created."
msgstr "RFC 3339 格式的日期，表示用户账号的创建时间。"

#. /paths/~1ngadmin~1contacts/get/responses/200/content/application~1json/schema/properties/contacts/items/properties/lastLoginTime/description
#. /paths/~1ngadmin~1contacts~1{id}/get/responses/200/content/application~1json/schema/properties/records/properties/lastLoginTime/description
msgid "RFC 3339 date indicating when the user last logged in to the portal."
msgstr "RFC 3339 格式的日期，表示用户最近一次登录控制台的时间。"

#. /paths/~1ngadmin~1contacts/get/responses/200/content/application~1json/schema/properties/contacts/items/properties/customerId/description
msgid ""
"ID of the customer to which the user belongs. This is returned if a reseller "
"specifies the Report-Range header with a value of self+children or children-"
"only."
msgstr ""
"该用户所属客户的 ID。当代理商将 Report-Range 请求头的值指定为 self+children "
"或 children-only 时返回此字段。"

#. /paths/~1ngadmin~1contacts/get/description
msgid ""
"Get a list of CDN Pro portal users. Use the query parameters to filter the "
"results. If you are a reseller you may use the <i>Report-Range</i> request "
"header to get a list of user accounts from child customers as well, or use "
"the On-Behalf-Of header to get results from a single child customer."
msgstr ""
"获取 CDN Pro 控制台用户列表。您可以使用查询参数筛选结果。如果您是代理商，可以"
"使用 <i>Report-Range</i> 请求头同时获取子客户的用户账号列表，或使用 On-"
"Behalf-Of 请求头获取单个子客户的结果。"

#. /paths/~1ngadmin~1contacts/get/parameters/1/description
msgid ""
"Maximum number of portal user accounts to return. The default is to return a "
"summary of all user accounts."
msgstr "要返回的控制台用户账号的最大数量。默认返回所有用户账号的摘要。"

#. /paths/~1ngadmin~1contacts/get/parameters/2/description
msgid ""
"Filter results by searching for text in the ID, firstName, lastName, "
"emailAddress, and loginName fields."
msgstr ""
"通过在 ID、firstName、lastName、emailAddress 和 loginName 字段中搜索文本来过"
"滤结果。"

#. /paths/~1ngadmin~1contacts/get/parameters/3/description
msgid "Sort results by either creation time or last login time."
msgstr "按创建时间或最近登录时间对结果排序。"

#. /paths/~1ngadmin~1contacts/get/parameters/4/description
msgid ""
"Indicates whether to return results in ascending order (asc) or descending "
"order (desc)."
msgstr "表示按升序 (asc) 还是降序 (desc) 返回结果。"

#. /paths/~1ngadmin~1contacts/get/parameters/5/description
msgid ""
"Filter users by status.  An account can be <i>active</i>, which means login "
"is allowed; <i>pending</i>, which means the user has been invited to use the "
"portal but has not completed setting up an account; or <i>suspended</i>, "
"which prevents logins."
msgstr ""
"按状态过滤用户。账号可以是 <i>active</i>，表示允许登录；<i>pending</i>，表示"
"用户已被邀请使用控制台但尚未完成账号设置；或 <i>suspended</i>，表示禁止登录。"

#. /paths/~1ngadmin~1contacts/get/parameters/6/description
msgid ""
"An optional header that resellers can use to specify whether to include data "
"from children customers. <table><tr><th>Value</th><th>Behavior</th></"
"tr><tr><td>self-only</td><td>Include accounts of the caller.</td></"
"tr><tr><td>children-only</td><td>Include  accounts of children customers "
"only.</td></tr><tr><td>self+children</td><td>Include accounts of both the "
"caller and children customers.</td></tr></table>"
msgstr ""
"可选请求头，代理商可用它指定是否包含子客户的数据。<table><tr><th>值</th><th>"
"行为</th></tr><tr><td>self-only</td><td>包含调用者本身的账号。</td></"
"tr><tr><td>children-only</td><td>仅包含子客户的账号。</td></"
"tr><tr><td>self+children</td><td>同时包含调用者本身和子客户的账号。</td></"
"tr></table>"

#. /paths/~1ngadmin~1contacts/get/parameters/8/description
msgid "Comma-separated list of user IDs to return."
msgstr "要返回的用户 ID 列表，以逗号分隔。"

#. /paths/~1ngadmin~1contacts/get/parameters/9/description
msgid ""
"Whether to return only the portal users with full access to all products."
msgstr "是否仅返回拥有所有产品完全访问权限的控制台用户。"

#. /paths/~1ngadmin~1apiAccounts~1{id}/get/summary
msgid "Get one API account"
msgstr "获取单个 API 账号"

#. /paths/~1ngadmin~1apiAccounts~1{id}/get/responses/200/description
msgid "The response body contains details about the API account."
msgstr "响应体包含该 API 账号的详细信息。"

#. /paths/~1ngadmin~1apiAccounts~1{id}/get/responses/200/content/application~1json/schema/properties/id/description
msgid "Id of the API account."
msgstr "API 账号的 ID。"

#. /paths/~1ngadmin~1apiAccounts~1{id}/get/responses/200/content/application~1json/schema/properties/responsiblePerson/description
#. /paths/~1ngadmin~1apiAccounts~1{id}/patch/requestBody/content/application~1json/schema/properties/responsiblePerson/description
#. /paths/~1ngadmin~1apiAccounts/post/requestBody/content/application~1json/schema/properties/responsiblePerson/description
#. (+1 more)
msgid "Name of the primary user of the API account."
msgstr "API 账号主要使用者的姓名。"

#. /paths/~1ngadmin~1apiAccounts~1{id}/get/responses/200/content/application~1json/schema/properties/type/description
#. /paths/~1ngadmin~1apiAccounts~1{id}/patch/responses/200/content/application~1json/schema/properties/type/description
#. /paths/~1ngadmin~1apiAccounts~1{id}/patch/requestBody/content/application~1json/schema/properties/type/description
#. (+1 more)
msgid ""
"Type of account. A <i>read-only</i> account can only access APIs that make "
"no modifications. An <i>operator</i> account can call APIs to make changes "
"such as creating or updating properties."
msgstr ""
"账号类型。<i>read-only</i> 账号只能访问不做任何修改的 API。<i>operator</i> 账"
"号可以调用 API 进行更改，例如创建或修改加速项目。"

#. /paths/~1ngadmin~1apiAccounts~1{id}/get/responses/200/content/application~1json/schema/properties/products/description
#. /paths/~1ngadmin~1apiAccounts~1{id}/patch/responses/200/content/application~1json/schema/properties/products/description
#. /paths/~1ngadmin~1apiAccounts~1{id}/patch/requestBody/content/application~1json/schema/properties/products/description
#. (+1 more)
msgid ""
"Products that the API account has access to.  Supported products are \"CDN\" "
"representing CDN Pro and \"HDT\" representing High-Speed Data Transmission."
msgstr ""
"该 API 账号有权访问的产品。支持的产品有 \"CDN\"（表示 CDN Pro）和 \"HDT\"（表"
"示 High-Speed Data Transmission）。"

#. /paths/~1ngadmin~1apiAccounts~1{id}/get/responses/200/content/application~1json/schema/properties/emailAddress/description
#. /paths/~1ngadmin~1apiAccounts~1{id}/patch/responses/200/content/application~1json/schema/properties/emailAddress/description
#. /paths/~1ngadmin~1apiAccounts~1{id}/patch/requestBody/content/application~1json/schema/properties/emailAddress/description
#. (+3 more)
msgid "Email address of the primary user of the API account."
msgstr "API 账号主要使用者的电子邮件地址。"

#. /paths/~1ngadmin~1apiAccounts~1{id}/get/responses/200/content/application~1json/schema/properties/customerId/description
msgid "ID of the customer that owns the API account."
msgstr "拥有该 API 账号的客户的 ID。"

#. /paths/~1ngadmin~1apiAccounts~1{id}/get/responses/200/content/application~1json/schema/properties/ipWhiteList/description
#. /paths/~1ngadmin~1apiAccounts~1{id}/patch/requestBody/content/application~1json/schema/properties/ipWhiteList/description
msgid ""
"List of IP addresses from which API calls using this account are permitted. "
"Inherits the corresponding setting at customer level, if unspecified. You "
"can specify a range, an individual IP address, or an IP in CIDR notation.  "
"Example: <code>[\"1.1.1.1-1.1.1.8\", \"1.2.3.4\", \"1.5.5.0/24\"]</code>  "
"The default permits API calls from all IP addresses. For security, we "
"strongly recommend specifying appropriate IP addresses for your company. API "
"calls from forbidden IPs would get an HTTP 403 response with a body "
"<code>{\"code\" : \"AccessDenied\", \"message\" : \"This request is rejected "
"due to IP restriction.\"}</code>."
msgstr ""
"允许使用此账号发起 API 调用的 IP 地址列表。如果未指定，则继承客户级别的相应设"
"置。您可以指定一个范围、单个 IP 地址或 CIDR 表示法的 IP。示例："
"<code>[\"1.1.1.1-1.1.1.8\", \"1.2.3.4\", \"1.5.5.0/24\"]</code> 默认允许来自"
"所有 IP 地址的 API 调用。为安全起见，我们强烈建议为您的公司指定合适的 IP 地"
"址。来自禁止 IP 的 API 调用将收到 HTTP 403 响应，响应体为 <code>{\"code\" : "
"\"AccessDenied\", \"message\" : \"This request is rejected due to IP "
"restriction.\"}</code>。"

#. /paths/~1ngadmin~1apiAccounts~1{id}/get/responses/404/description
msgid "The account was not found."
msgstr "找不到该账号。"

#. /paths/~1ngadmin~1apiAccounts~1{id}/get/description
msgid "Get details about an API account."
msgstr "获取 API 账号的详细信息。"

#. /paths/~1ngadmin~1apiAccounts~1{id}/patch/summary
msgid "Update an API account"
msgstr "修改 API 账号"

#. /paths/~1ngadmin~1apiAccounts~1{id}/patch/responses/200/description
msgid "The account was successfully updated."
msgstr "账号已成功修改。"

#. /paths/~1ngadmin~1apiAccounts~1{id}/patch/responses/200/content/application~1json/schema/description
msgid "Updated API account."
msgstr "修改后的 API 账号。"

#. /paths/~1ngadmin~1apiAccounts~1{id}/patch/responses/200/content/application~1json/schema/properties/customerId/description
#. /paths/~1ngadmin~1apiAccounts/post/responses/201/content/application~1json/schema/properties/customerId/description
msgid "ID of the associated customer."
msgstr "关联客户的 ID。"

#. /paths/~1ngadmin~1apiAccounts~1{id}/patch/responses/200/content/application~1json/schema/properties/responsiblePerson/description
#. /paths/~1ngadmin~1apiAccounts/post/responses/201/content/application~1json/schema/properties/responsiblePerson/description
msgid "Name of the person using the API key."
msgstr "使用该 API 密钥的人员姓名。"

#. /paths/~1ngadmin~1apiAccounts~1{id}/patch/responses/200/content/application~1json/schema/properties/apikey/description
msgid ""
"API key used to authenticate API calls. This field is returned only if the "
"call requested a reset of the API key."
msgstr ""
"用于认证 API 调用的 API 密钥。仅当调用请求重置 API 密钥时才返回此字段。"

#. /paths/~1ngadmin~1apiAccounts~1{id}/patch/description
msgid ""
"Update an API account's settings. If you need to change the default "
"permissions of the API account, call our API to <a href=\"/apidocs/api-"
"access-control/post-cdn-apipermissions\">create a custom API permission "
"object</a>."
msgstr ""
"修改 API 账号的设置。如果您需要更改 API 账号的默认权限，请调用 API <a "
"href=\"/apidocs/api-access-control/post-cdn-apipermissions\">创建自定义 API "
"权限对象</a>。"

#. /paths/~1ngadmin~1apiAccounts~1{id}/patch/requestBody/content/application~1json/schema/properties/apiKey/description
msgid ""
"If specified, the field's value must be <i>reset</i>. A new random API key "
"will be generated for the API account."
msgstr ""
"如果指定，该字段的值必须为 <i>reset</i>。系统将为该 API 账号生成一个新的随机 "
"API 密钥。"

#. /paths/~1ngadmin~1apiAccounts~1{id}/patch/requestBody/description
msgid ""
"Specify the fields to update. Fields that are omitted will not be updated."
msgstr "指定要修改的字段。省略的字段不会被修改。"

#. /paths/~1ngadmin~1apiAccounts~1{id}/delete/summary
msgid "Delete an API account"
msgstr "删除 API 账号"

#. /paths/~1ngadmin~1apiAccounts~1{id}/delete/responses/204/description
msgid "The API account was deleted."
msgstr "API 账号已删除。"

#. /paths/~1ngadmin~1apiAccounts~1{id}/delete/description
msgid "Delete an API account."
msgstr "删除 API 账号。"

#. /paths/~1ngadmin~1apiAccounts~1{id}/parameters/0/description
msgid "The ID of the API account."
msgstr "API 账号的 ID。"

#. /paths/~1ngadmin~1apiAccounts/post/summary
msgid "Create an API account"
msgstr "创建 API 账号"

#. /paths/~1ngadmin~1apiAccounts/post/responses/201/description
msgid ""
"The API account was successfully created. The Location header has a URL to "
"the new account with an ID that you can use to query and update. Example:"
"<code>Location: https://ngapi.{{siteDomain}}/ngadmin/apiAccounts/2</code> "
"The response body describes the account and includes an automatically "
"generated API key."
msgstr ""
"API 账号已成功创建。Location 头包含指向新账号的 URL，其中的 ID 可用于查询和修"
"改。示例：<code>Location: https://ngapi.{{siteDomain}}/ngadmin/apiAccounts/"
"2</code> 响应体描述了该账号，并包含一个自动生成的 API 密钥。"

#. /paths/~1ngadmin~1apiAccounts/post/responses/201/headers/Location/description
msgid ""
"URL of the new API account. The URL follows this format: https://ngapi."
"{{siteDomain}}/ngadmin/apiAccounts/{accountId} where {accountId} represents "
"the ID of the newly created account. If you would like to get the account "
"ID, simply extract the last portion of the path and ignore the rest. The ID "
"can be used to query, update, or delete the API account. "
msgstr ""
"新 API 账号的 URL。URL 格式如下：https://ngapi.{{siteDomain}}/ngadmin/"
"apiAccounts/{accountId}，其中 {accountId} 表示新建账号的 ID。如果您需要获取账"
"号 ID，只需提取路径的最后一部分，忽略其余部分即可。该 ID 可用于查询、修改或删"
"除该 API 账号。"

#. /paths/~1ngadmin~1apiAccounts/post/responses/201/content/application~1json/schema/description
msgid "API account details."
msgstr "API 账号详细信息。"

#. /paths/~1ngadmin~1apiAccounts/post/responses/201/content/application~1json/schema/properties/apiKey/description
msgid "API key used to authenticate API calls."
msgstr "用于认证 API 调用的 API 密钥。"

#. /paths/~1ngadmin~1apiAccounts/post/responses/201/content/application~1json/schema/properties/type/description
msgid ""
"Type of account. A <i>read-only</i> account can only access APIs that make "
"no modifications.  An <i>operator</i> account can call APIs to make changes "
"such as creating or updating properties."
msgstr ""
"账号类型。<i>read-only</i> 账号只能访问不做任何修改的 API。<i>operator</i> 账"
"号可以调用 API 进行更改，例如创建或修改加速项目。"

#. /paths/~1ngadmin~1apiAccounts/post/responses/201/content/application~1json/schema/properties/products/description
msgid ""
"Products that the API account has access to.  Supported products are \"CDN\" "
"and \"HDT\"."
msgstr "该 API 账号有权访问的产品。支持的产品有 \"CDN\" 和 \"HDT\"。"

#. /paths/~1ngadmin~1apiAccounts/post/responses/401/description
msgid "Unauthorized"
msgstr "未授权"

#. /paths/~1ngadmin~1apiAccounts/post/responses/409/description
msgid "The API account already exists."
msgstr "该 API 账号已存在。"

#. /paths/~1ngadmin~1apiAccounts/post/description
msgid ""
"Create an API account that can be used to call CDN Pro APIs in addition to "
"your administrator API account. You can grant <i>read-only</i> access, which "
"permits calling API endpoints using the HTTP GET method only, OR "
"<i>operator</i> access, which also allows creating, updating, and deleting "
"objects like properties and certificates. \n"
"<br/><br/>After creating an API account, you must call our <a \n"
"href=\"/apidocs/api-access-control/post-cdn-apipermissions\">API to create "
"custom permissions</a> for it and define the endpoints that can be accessed. "
"After that, you can make additional changes by calling our <a href=\"/"
"apidocs/api-access-control/patch-cdn-apipermissions-id\">API to modify the "
"permissions</a>."
msgstr ""
"除管理员 API 账号外，您还可以创建其他 API 账号来调用 CDN Pro API。您可以授予 "
"<i>read-only</i> 权限，仅允许使用 HTTP GET 方法调用 API 接口；或授予 "
"<i>operator</i> 权限，还允许创建、修改和删除加速项目、证书等对象。\n"
"<br/><br/>创建 API 账号后，您必须调用 <a \n"
"href=\"/apidocs/api-access-control/post-cdn-apipermissions\">创建自定义权限"
"的 API</a> 为其定义可访问的接口。之后，您可以调用<a href=\"/apidocs/api-"
"access-control/patch-cdn-apipermissions-id\">修改权限的 API</a> 做进一步修"
"改。"

#. /paths/~1ngadmin~1apiAccounts/post/requestBody/content/application~1json/schema/properties/type/description
msgid ""
"Type of account. A <i>read-only</i> account can only call APIs that make no "
"modifications. In essence, this type of account can call endpoints using the "
"HTTP GET method only. On the other hand, an <i>operator</i> account can also "
"call APIs to make changes such as creating, updating, and deleting a "
"property."
msgstr ""
"账号类型。<i>read-only</i> 账号只能调用不做任何修改的 API，实际上，此类账号只"
"能使用 HTTP GET 方法调用接口。而 <i>operator</i> 账号还可以调用 API 进行更"
"改，例如创建、修改和删除加速项目。"

#. /paths/~1ngadmin~1apiAccounts/post/requestBody/content/application~1json/schema/properties/ipWhiteList/description
msgid ""
"List of IP addresses from which API calls using this account are permitted. "
"Inherits the corresponding setting at customer level, if unspecified. You "
"can specify a range, an individual IP address, or an IP in CIDR notation.  "
"Example: <code>[\"1.1.1.1-1.1.1.8\", \"1.2.3.4\", \"1.5.5.0/24\"]</code>  "
"The default permits API calls from all IP addresses. For security, we "
"strongly recommend specifying appropriate IP addresses for your company. API "
"calls from forbidden IPs would get an HTTP 403 response with a body "
"<code>{\"code\" : \"AccessDenied\", \"message\" : \"This request is rejected "
"due to IP restriction.\"}</code>.\n"
msgstr ""
"允许使用此账号发起 API 调用的 IP 地址列表。如果未指定，则继承客户级别的相应设"
"置。您可以指定一个范围、单个 IP 地址或 CIDR 表示法的 IP。示例："
"<code>[\"1.1.1.1-1.1.1.8\", \"1.2.3.4\", \"1.5.5.0/24\"]</code> 默认允许来自"
"所有 IP 地址的 API 调用。为安全起见，我们强烈建议为您的公司指定合适的 IP 地"
"址。来自禁止 IP 的 API 调用将收到 HTTP 403 响应，响应体为 <code>{\"code\" : "
"\"AccessDenied\", \"message\" : \"This request is rejected due to IP "
"restriction.\"}</code>。\n"

#. /paths/~1ngadmin~1apiAccounts/post/requestBody/description
msgid "Information about the new API account."
msgstr "新 API 账号的信息。"

#. /paths/~1ngadmin~1apiAccounts/get/summary
msgid "Get a list of API accounts"
msgstr "获取 API 账号列表"

#. /paths/~1ngadmin~1apiAccounts/get/responses/200/description
msgid "List of API accounts."
msgstr "API 账号列表。"

#. /paths/~1ngadmin~1apiAccounts/get/responses/200/content/application~1json/schema/properties/count/description
msgid "Number of API accounts."
msgstr "API 账号的数量。"

#. /paths/~1ngadmin~1apiAccounts/get/responses/200/content/application~1json/schema/properties/accounts/description
msgid "Contains objects describing API accounts."
msgstr "包含描述 API 账号的对象。"

#. /paths/~1ngadmin~1apiAccounts/get/responses/200/content/application~1json/schema/properties/accounts/items/description
msgid "An API account."
msgstr "一个 API 账号。"

#. /paths/~1ngadmin~1apiAccounts/get/responses/200/content/application~1json/schema/properties/accounts/items/properties/id/description
#. /paths/~1cdn~1apiPermissions/post/requestBody/content/application~1json/schema/properties/apiAccountId/description
#. /paths/~1cdn~1apiPermissions~1{id}/parameters/0/description
#. (+2 more)
msgid "ID of an API account."
msgstr "API 账号的 ID。"

#. /paths/~1ngadmin~1apiAccounts/get/responses/200/content/application~1json/schema/properties/accounts/items/properties/creationTime/description
msgid "RFC 3339 date indicating when the API account was created."
msgstr "RFC 3339 格式的日期，表示 API 账号的创建时间。"

#. /paths/~1ngadmin~1apiAccounts/get/responses/200/content/application~1json/schema/properties/accounts/items/properties/lastUpdateTime/description
msgid ""
"RFC 3339 date indicating when the API account was most recently updated."
msgstr "RFC 3339 格式的日期，表示 API 账号最近一次修改的时间。"

#. /paths/~1ngadmin~1apiAccounts/get/responses/200/content/application~1json/schema/properties/accounts/items/properties/customerId/description
msgid ""
"ID of the customer to which the API account belongs. This is returned if a "
"reseller specifies the Report-Range header with a value of self+children or "
"children-only."
msgstr ""
"该 API 账号所属客户的 ID。当代理商将 Report-Range 请求头的值指定为 "
"self+children 或 children-only 时返回此字段。"

#. /paths/~1ngadmin~1apiAccounts/get/description
msgid ""
"Get a list of API accounts belonging to you. You can filter the results "
"using query parameters. If you are a reseller, you can also use the Report-"
"Range header to get all the API accounts from your child customers as well."
msgstr ""
"获取属于您的 API 账号列表。您可以使用查询参数筛选结果。如果您是代理商，还可以"
"使用 Report-Range 请求头同时获取所有子客户的 API 账号。"

#. /paths/~1ngadmin~1apiAccounts/get/parameters/0/description
msgid ""
"An optional header that resellers can use to specify whether to include data "
"from children customers. <table><tr><th>Value</th><th>Behavior</th></"
"tr><tr><td>self-only</td><td>Include API accounts of the caller.</td></"
"tr><tr><td>children-only</td><td>Include API accounts of children customers "
"only.</td></tr><tr><td>self+children</td><td>Include API accounts of both "
"the caller and children customers.</td></tr></table>"
msgstr ""
"可选请求头，代理商可用它指定是否包含子客户的数据。<table><tr><th>值</th><th>"
"行为</th></tr><tr><td>self-only</td><td>包含调用者本身的 API 账号。</td></"
"tr><tr><td>children-only</td><td>仅包含子客户的 API 账号。</td></"
"tr><tr><td>self+children</td><td>同时包含调用者本身和子客户的 API 账号。</"
"td></tr></table>"

#. /paths/~1ngadmin~1apiAccounts/get/parameters/2/description
msgid ""
"Maximum number of accounts to return. The default is to return a summary of "
"all accounts."
msgstr "要返回的账号的最大数量。默认返回所有账号的摘要。"

#. /paths/~1ngadmin~1apiAccounts/get/parameters/3/description
msgid ""
"Keyword to search for in the id, responsiblePerson, emailAddress, and "
"apiName fields."
msgstr "在 id、responsiblePerson、emailAddress 和 apiName 字段中搜索的关键字。"

#. /paths/~1ngadmin~1apiAccounts/get/parameters/4/description
msgid "Sort accounts by their creation time or when they were last updated.\n"
msgstr "按账号的创建时间或最近修改时间排序。\n"

#. /paths/~1ngadmin~1apiAccounts/get/parameters/5/description
msgid ""
"Order of accounts returned by the API, either <i>asc</i> for ascending or "
"<i>desc</i> for descending."
msgstr "API 返回账号的顺序，<i>asc</i> 表示升序，<i>desc</i> 表示降序。"

#. /paths/~1ngadmin~1apiAccounts/get/parameters/7/description
msgid ""
"Specify <i>operator</i> or <i>read-only</i> to filter the results. If "
"unspecified, all API accounts will be returned."
msgstr ""
"指定 <i>operator</i> 或 <i>read-only</i> 来过滤结果。如果未指定，将返回所有 "
"API 账号。"

#. /paths/~1ngadmin~1contacts~1{id}/parameters/0/description
msgid "ID of a user. The ID is returned when creating a new user."
msgstr "用户的 ID。创建新用户时会返回该 ID。"

#. /paths/~1ngadmin~1contacts~1{id}/get/summary
msgid "Get a portal user"
msgstr "获取控制台用户"

#. /paths/~1ngadmin~1contacts~1{id}/get/responses/200/description
msgid "The response body contains details about the user."
msgstr "响应体包含该用户的详细信息。"

#. /paths/~1ngadmin~1contacts~1{id}/get/responses/200/content/application~1json/schema/properties/loginName/description
msgid "Name used to log in to the portal."
msgstr "用于登录控制台的名称。"

#. /paths/~1ngadmin~1contacts~1{id}/get/responses/200/content/application~1json/schema/properties/timeZone/description
msgid "User's time zone. Can be in the format \"GMT+4\" or \"GMT-11\""
msgstr "用户的时区。可以采用 \"GMT+4\" 或 \"GMT-11\" 这样的格式"

#. /paths/~1ngadmin~1contacts~1{id}/get/responses/200/content/application~1json/schema/properties/language/description
msgid ""
"The user's language. It is a two character value representing English (en), "
"Chinese (cn), Korean (kr), Japanese (jp), Russian (ru), or French (fr).\n"
msgstr ""
"用户的语言。它是一个两字符的值，表示英语 (en)、中文 (cn)、韩语 (kr)、日语 "
"(jp)、俄语 (ru) 或法语 (fr)。\n"

#. /paths/~1ngadmin~1contacts~1{id}/get/responses/200/content/application~1json/schema/properties/records/description
msgid ""
"Contains additional information about the user account including when the "
"user last logged in."
msgstr "包含该用户账号的其他信息，包括用户最近一次登录的时间。"

#. /paths/~1ngadmin~1contacts~1{id}/get/responses/200/content/application~1json/schema/properties/records/properties/customerId/description
msgid "ID of the customer to which this user belongs."
msgstr "该用户所属客户的 ID。"

#. /paths/~1ngadmin~1contacts~1{id}/get/responses/200/content/application~1json/schema/properties/records/properties/creationtime/description
msgid "RFC 3339 date indicating when the user was added."
msgstr "RFC 3339 格式的日期，表示该用户的添加时间。"

#. /paths/~1ngadmin~1contacts~1{id}/get/responses/200/content/application~1json/schema/properties/records/properties/lastUpdateTime/description
msgid "RFC 3339 date indicating when the account was last updated."
msgstr "RFC 3339 格式的日期，表示该账号最近一次修改的时间。"

#. /paths/~1ngadmin~1contacts~1{id}/get/responses/200/content/application~1json/schema/properties/address/description
#. /paths/~1ngadmin~1contacts~1{id}/patch/requestBody/content/application~1json/schema/properties/address/description
msgid "The user's address."
msgstr "用户的地址。"

#. /paths/~1ngadmin~1contacts~1{id}/get/responses/200/content/application~1json/schema/properties/address/properties/zipCode/description
msgid "A zip or postal code."
msgstr "邮政编码。"

#. /paths/~1ngadmin~1contacts~1{id}/get/responses/200/content/application~1json/schema/properties/address/properties/country/description
#. /paths/~1ngadmin~1contacts~1{id}/patch/requestBody/content/application~1json/schema/properties/address/properties/country/description
msgid "Country of the address."
msgstr "地址所在的国家/地区。"

#. /paths/~1ngadmin~1contacts~1{id}/get/responses/404/description
msgid "The user was not found."
msgstr "找不到该用户。"

#. /paths/~1ngadmin~1contacts~1{id}/get/description
msgid "Return information about a CDN Pro portal user."
msgstr "返回 CDN Pro 控制台用户的信息。"

#. /paths/~1ngadmin~1contacts~1{id}/delete/summary
msgid "Delete a portal user"
msgstr "删除控制台用户"

#. /paths/~1ngadmin~1contacts~1{id}/delete/responses/204/description
msgid "The user was successfully deleted."
msgstr "用户已成功删除。"

#. /paths/~1ngadmin~1contacts~1{id}/delete/responses/404/description
msgid "The user account could not be found."
msgstr "找不到该用户账号。"

#. /paths/~1ngadmin~1contacts~1{id}/delete/description
msgid "Delete a CDN Pro portal user account using this API."
msgstr "使用此 API 删除 CDN Pro 控制台用户账号。"

#. /paths/~1ngadmin~1contacts~1{id}/patch/summary
msgid "Update a portal user"
msgstr "修改控制台用户"

#. /paths/~1ngadmin~1contacts~1{id}/patch/responses/200/description
msgid "The user account was updated."
msgstr "用户账号已修改。"

#. /paths/~1ngadmin~1contacts~1{id}/patch/description
msgid ""
"Update a CDN Pro portal user account. Only fields in the request body will "
"be updated."
msgstr "修改 CDN Pro 控制台用户账号。只有请求体中包含的字段会被修改。"

#. /paths/~1ngadmin~1contacts~1{id}/patch/requestBody/content/application~1json/schema/properties/timeZone/description
msgid "User's time zone. Can be in the format \"GMT+4\" or \"GMT-11\"."
msgstr "用户的时区。可以采用 \"GMT+4\" 或 \"GMT-11\" 这样的格式。"

#. /paths/~1ngadmin~1contacts~1{id}/patch/requestBody/content/application~1json/schema/properties/address/properties/zipCode/description
msgid "The postal or zip code."
msgstr "邮政编码。"

#. /paths/~1ngadmin~1contacts~1{id}/patch/requestBody/content/application~1json/schema/properties/password/description
msgid ""
"New password for the user. We recommend that users set their own passwords "
"through our portal."
msgstr "用户的新密码。我们建议用户通过我们的控制台自行设置密码。"

#. /paths/~1ngadmin~1contacts~1{id}/patch/requestBody/content/application~1json/schema/properties/reset2fa/description
msgid ""
"Set to <i>true</i> to force the user to go through the two factor "
"authentication setup process when logging in. This applies only if you have "
"chosen to require two factor authentication for improved security. You can "
"enable the feature by setting <i>enforce2fa</i> to <i>true</i> when <a "
"href=\"/apidocs/customer-management/patch-ngadmin-customers-id\">updating "
"your account</a>. A common reason to use <i>reset2fa</i> is when the user "
"switches to a new phone."
msgstr ""
"设置为 <i>true</i> 可强制用户在登录时重新完成双因素认证的设置流程。仅当您为提"
"高安全性而选择要求双因素认证时才适用。您可以在<a href=\"/apidocs/customer-"
"management/patch-ngadmin-customers-id\">修改您的账号</a>时将 <i>enforce2fa</"
"i> 设置为 <i>true</i> 来启用此功能。使用 <i>reset2fa</i> 的一个常见原因是用户"
"换了新手机。"

#. /paths/~1ngadmin~1contacts~1{id}/patch/requestBody/description
msgid ""
"The request body contains the fields that will be updated.  If a field is "
"omitted, it will not be modified."
msgstr "请求体包含要修改的字段。省略的字段不会被修改。"

#. /paths/~1cdn~1report~1edgeHostnameReq/post/summary
msgid "Get edge hostname statistics"
msgstr "获取调度域名统计数据"

#. /paths/~1cdn~1report~1edgeHostnameReq/post/responses/200/description
msgid "The response contains the data.  It is always in UTC time."
msgstr "响应包含数据，始终使用 UTC 时间。"

#. /paths/~1cdn~1report~1edgeHostnameReq/post/description
msgid ""
"Get the number of DNS requests to resolve your edge hostnames during a time "
"period."
msgstr "获取一段时间内解析您调度域名的 DNS 请求数。"

#. /paths/~1cdn~1report~1edgeHostnameReq/post/parameters/1/description
#. /paths/~1cdn~1report~1edgeHostnameReqSummary/post/parameters/0/description
#. /paths/~1cdn~1report~1edgeHostnameReqSummary/get/parameters/0/description
#. (+2 more)
msgid ""
"RFC 3339 date indicating the beginning of the time period. The time must be "
"specified using the UTC timezone; it cannot be an offset. Example: "
"<code>startdate=2019-11-14T00:00:00Z</code>"
msgstr ""
"RFC 3339 格式的日期，表示时间段的开始。时间必须使用 UTC 时区指定，不能使用时"
"区偏移。示例：<code>startdate=2019-11-14T00:00:00Z</code>"

#. /paths/~1cdn~1report~1edgeHostnameReq/post/parameters/2/description
msgid ""
"RFC 3339 date indicating the end of the time span. The time must be "
"specified using the UTC timezone; it cannot be an offset. Example: "
"<code>enddate=2019-11-14T00:00:00Z</code>"
msgstr ""
"RFC 3339 格式的日期，表示时间跨度的结束。时间必须使用 UTC 时区指定，不能使用"
"时区偏移。示例：<code>enddate=2019-11-14T00:00:00Z</code>"

#. /paths/~1cdn~1report~1edgeHostnameReq/post/requestBody/content/application~1json/schema/properties/filters/description
msgid "Limit statistics to specific edge hostnames."
msgstr "将统计数据限制为特定的调度域名。"

#. /paths/~1cdn~1report~1edgeHostnameReq/post/requestBody/content/application~1json/schema/properties/filters/properties/edgeHostnames/description
#. /paths/~1cdn~1report~1edgeHostnameReqSummary/post/requestBody/content/application~1json/schema/properties/filters/properties/edgeHostnames/description
msgid "One or more edge hostnames."
msgstr "一个或多个调度域名。"

#. /paths/~1cdn~1report~1edgeHostnameReq/post/requestBody/description
msgid ""
"Optionally specify the edge hostnames to obtain statistics for them. If "
"unspecified, data for all edge hostnames in your account will be returned."
msgstr ""
"您可以选择指定调度域名，以获取这些调度域名的统计数据。如未指定，将返回您账户"
"下所有调度域名的数据。"

#. /paths/~1cdn~1report~1edgeHostnameReqSummary/post/summary
#. /paths/~1cdn~1report~1edgeHostnameReqSummary/get/summary
msgid "Get edge hostname summary statistics"
msgstr "获取调度域名汇总统计数据"

#. /paths/~1cdn~1report~1edgeHostnameReqSummary/post/responses/200/description
#. /paths/~1cdn~1report~1edgeHostnameReqSummary/post/responses/200/content/application~1json/schema/description
#. /paths/~1cdn~1report~1edgeHostnameReqSummary/get/responses/200/description
#. (+1 more)
msgid ""
"The response contains a summary of DNS requests by edge hostname. It can "
"contain up to 10000 groups representing a breakdown of requests by 10000 "
"edge hostnames. If there are more than 10000 groups, the value of "
"\"isComplete\" will be false. A special group \"\\_\\_all\\_\\_\" contains "
"the total for all groups including those beyond the 10000 limit.  When "
"\"isComplete\" is true, the total is the sum of all other returned groups."
msgstr ""
"响应包含按调度域名划分的 DNS 请求汇总数据，最多可包含 10000 个分组，即按 "
"10000 个调度域名细分的请求数据。如果分组超过 10000 个，\"isComplete\" 的值将"
"为 false。特殊分组 \"\\_\\_all\\_\\_\" 包含所有分组的总计，包括超出 10000 个"
"限制的分组。当 \"isComplete\" 为 true 时，该总计等于其他所有返回分组之和。"

#. /paths/~1cdn~1report~1edgeHostnameReqSummary/post/responses/200/content/application~1json/schema/title
#. /paths/~1cdn~1report~1edgeHostnameReqSummary/get/responses/200/content/application~1json/schema/title
msgid "edgeHostnameSummaryResponse"
msgstr "edgeHostnameSummaryResponse"

#. /paths/~1cdn~1report~1edgeHostnameReqSummary/post/responses/200/content/application~1json/schema/properties/metaData/properties/dataNames/description
#. /paths/~1cdn~1report~1edgeHostnameReqSummary/get/responses/200/content/application~1json/schema/properties/metaData/properties/dataNames/description
msgid "Indicates the type of data returned: \"edgeHostname dns request\""
msgstr "表示返回数据的类型：\"edgeHostname dns request\""

#. /paths/~1cdn~1report~1edgeHostnameReqSummary/post/responses/200/content/application~1json/schema/properties/groups/description
#. /paths/~1cdn~1report~1edgeHostnameReqSummary/get/responses/200/content/application~1json/schema/properties/groups/description
msgid ""
"This object contains the breakdown of DNS requests by group. Groups are "
"determined by the request body."
msgstr "此对象包含按分组细分的 DNS 请求数据。分组由请求体决定。"

#. /paths/~1cdn~1report~1edgeHostnameReqSummary/post/responses/200/content/application~1json/schema/properties/groups/items/properties/group/description
#. /paths/~1cdn~1report~1edgeHostnameReqSummary/get/responses/200/content/application~1json/schema/properties/groups/items/properties/group/description
msgid ""
"Name of a group.  \"\\_\\_all\\_\\_\" is a special group encompassing all "
"groups.\n"
msgstr "分组名称。\"\\_\\_all\\_\\_\" 是涵盖所有分组的特殊分组。\n"

#. /paths/~1cdn~1report~1edgeHostnameReqSummary/post/responses/200/content/application~1json/schema/properties/groups/items/properties/data/description
#. /paths/~1cdn~1report~1edgeHostnameReqSummary/get/responses/200/content/application~1json/schema/properties/groups/items/properties/data/description
msgid ""
"Data value. The units of measurement are determined by the dataUnit field."
msgstr "数据值。计量单位由 dataUnit 字段决定。"

#. /paths/~1cdn~1report~1edgeHostnameReqSummary/post/description
#. /paths/~1cdn~1report~1edgeHostnameReqSummary/get/description
msgid ""
"Obtain a summary of DNS requests for one or more edge hostnames during a "
"time period. This API allows you to see the actual number of requests for "
"each edge hostname."
msgstr ""
"获取一段时间内一个或多个调度域名的 DNS 请求汇总。您可以通过此 API 查看每个调"
"度域名的实际请求数。"

#. /paths/~1cdn~1report~1edgeHostnameReqSummary/post/parameters/1/description
#. /paths/~1cdn~1report~1edgeHostnameReqSummary/get/parameters/1/description
msgid ""
"RFC 3339 date indicating the end of the time span. The time must be "
"specified using the UTC timezone; it cannot be an offset. Example: "
"<code>enddate=2019-11-14T00:00:00Z</code>. Due to latency associated with "
"new traffic data, enddate should be no later than five minutes before the "
"current time. This ensures you get the most accurate results."
msgstr ""
"RFC 3339 格式的日期，表示时间段的结束时间。时间必须使用 UTC 时区指定，不能使"
"用时区偏移。示例：<code>enddate=2019-11-14T00:00:00Z</code>。由于新流量数据存"
"在延迟，enddate 应不晚于当前时间前五分钟，以确保您获得最准确的结果。"

#. /paths/~1cdn~1report~1edgeHostnameReqSummary/post/requestBody/content/application~1json/schema/properties/filters/description
msgid "Limit statistics to specific edge hostnames.\n"
msgstr "将统计范围限定为指定的调度域名。\n"

#. /paths/~1cdn~1report~1edgeHostnameReqSummary/post/requestBody/content/application~1json/schema/properties/groupBy/description
msgid ""
"Specify an array containing \"edgeHostnames\" to get data for each edge "
"hostname. Omit to get only a cumulative total."
msgstr ""
"指定包含 \"edgeHostnames\" 的数组，以获取每个调度域名的数据。省略则仅获取累计"
"总数。"

#. /paths/~1cdn~1report~1edgeHostnameReqSummary/post/requestBody/description
msgid "You can request a breakdown of requests by edge hostname."
msgstr "您可以请求按调度域名细分的请求数据。"

#. /paths/~1cdn~1report~1edgeHostnameReqSummary/get/parameters/3/description
msgid ""
"Specify \"edgeHostnames\" to get data for each edge hostname. Omit to get "
"only a cumulative total."
msgstr ""
"指定 \"edgeHostnames\" 以获取每个调度域名的数据。省略则仅获取累计总数。"

#. /paths/~1cdn~1isps/get/summary
msgid "Get a list of ISPs"
msgstr "获取运营商列表"

#. /paths/~1cdn~1isps/get/responses/200/description
msgid ""
"The response contains a list of ISPs. You can specify an ISP's code in an <a "
"href=\"/apidocs/edge-hostname-management/createedgehostname\">edge "
"hostname's client zone rule</a>."
msgstr ""
"响应包含运营商列表。您可以在<a href=\"/apidocs/edge-hostname-management/"
"createedgehostname\">调度域名的客户端分区规则</a>中指定运营商代码。"

#. /paths/~1cdn~1isps/get/responses/200/content/application~1json/schema/description
msgid "A list of ISPs."
msgstr "运营商列表。"

#. /paths/~1cdn~1isps/get/responses/200/content/application~1json/schema/items/properties/code/description
msgid "A code representing an ISP."
msgstr "代表运营商的代码。"

#. /paths/~1cdn~1isps/get/responses/200/content/application~1json/schema/items/properties/name/description
msgid "Descriptive name of an ISP."
msgstr "运营商的描述性名称。"

#. /paths/~1cdn~1isps/get/description
msgid ""
"Obtain a list of ISPs that can be used in <a href=\"/apidocs/edge-hostname-"
"management/createedgehostname\">edge hostname client zone rules</a>."
msgstr ""
"获取可在<a href=\"/apidocs/edge-hostname-management/createedgehostname\">调度"
"域名客户端分区规则</a>中使用的运营商列表。"

#. /paths/~1cdn~1isps/get/parameters/0/description
msgid "Return ISPs whose code or name contains this value."
msgstr "返回代码或名称中包含此值的运营商。"

#. /paths/~1cdn~1isps/get/parameters/1/description
msgid ""
"Order of ISPs returned. Use 'asc' for ascending order or 'desc' for "
"descending order."
msgstr "返回的运营商的排列顺序。使用 'asc' 表示升序，使用 'desc' 表示降序。"

#. /paths/~1cdn~1isps/get/parameters/2/description
msgid ""
"Limit returned ISPs to those operating in a particular region. The value of "
"<i>regionCode</i> should be one of the codes representing a region returned "
"by the <a href=\"/apidocs/cdn-product-management/get-cdn-"
"clientregions\">client regions API</a>."
msgstr ""
"将返回的运营商限定为在特定区域运营的运营商。<i>regionCode</i> 的值应为<a "
"href=\"/apidocs/cdn-product-management/get-cdn-clientregions\">客户端区域 "
"API</a> 返回的区域代码之一。"

#. /paths/~1ngadmin~1customers~1{id}/parameters/0/description
msgid ""
"Specify the ID of a child customer. The value can be <i>me</i> if you wish "
"to retrieve or update your own settings. However, you cannot modify your own "
"<i>configs</i> and <i>chinaBizInfo</i> fields."
msgstr ""
"指定子客户的 ID。如果您希望获取或修改您自己的设置，可将值设为 <i>me</i>。但您"
"不能修改自己的 <i>configs</i> 和 <i>chinaBizInfo</i> 字段。"

#. /paths/~1ngadmin~1customers~1{id}/get/summary
msgid "Get details about a customer"
msgstr "获取客户详情"

#. /paths/~1ngadmin~1customers~1{id}/get/responses/200/description
msgid "The response body contains details about the customer account."
msgstr "响应体包含客户账户的详细信息。"

#. /paths/~1ngadmin~1customers~1{id}/get/responses/200/content/application~1json/schema/title
#. /paths/~1ngadmin~1customers~1{id}/patch/responses/200/content/application~1json/schema/title
msgid "customerresponse"
msgstr "customerresponse"

#. /paths/~1ngadmin~1customers~1{id}/get/responses/200/content/application~1json/schema/description
#. /paths/~1ngadmin~1customers~1{id}/patch/responses/200/content/application~1json/schema/description
msgid "Customer account details"
msgstr "客户账户详情"

#. /paths/~1ngadmin~1customers~1{id}/get/responses/200/content/application~1json/schema/properties/customerId/description
#. /paths/~1ngadmin~1customers~1{id}/patch/responses/200/content/application~1json/schema/properties/customerId/description
msgid "ID of the customer account."
msgstr "客户账户的 ID。"

#. /paths/~1ngadmin~1customers~1{id}/get/responses/200/content/application~1json/schema/properties/apiName/description
#. /paths/~1ngadmin~1customers~1{id}/patch/responses/200/content/application~1json/schema/properties/apiName/description
#. /paths/~1ngadmin~1customers/post/responses/201/content/application~1json/schema/properties/apiName/description
#. (+2 more)
msgid "Administrator API account name."
msgstr "管理员 API 账号名称。"

#. /paths/~1ngadmin~1customers~1{id}/get/responses/200/content/application~1json/schema/properties/name/description
#. /paths/~1ngadmin~1customers~1{id}/patch/responses/200/content/application~1json/schema/properties/name/description
#. /paths/~1ngadmin~1customers~1{id}/patch/requestBody/content/application~1json/schema/properties/name/description
#. (+2 more)
msgid "Customer name."
msgstr "客户名称。"

#. /paths/~1ngadmin~1customers~1{id}/get/responses/200/content/application~1json/schema/properties/phone/description
#. /paths/~1ngadmin~1customers~1{id}/patch/responses/200/content/application~1json/schema/properties/phone/description
msgid "A phone number.\n"
msgstr "电话号码。\n"

#. /paths/~1ngadmin~1customers~1{id}/get/responses/200/content/application~1json/schema/properties/configs/title
#. /paths/~1ngadmin~1customers~1{id}/patch/responses/200/content/application~1json/schema/properties/configs/title
#. /paths/~1ngadmin~1customers~1{id}/patch/requestBody/content/application~1json/schema/properties/configs/title
msgid "customerConfigsUpdatable"
msgstr "customerConfigsUpdatable"

#. /paths/~1ngadmin~1customers~1{id}/get/responses/200/content/application~1json/schema/properties/configs/description
#. /paths/~1ngadmin~1customers~1{id}/patch/responses/200/content/application~1json/schema/properties/configs/description
#. /paths/~1ngadmin~1customers~1{id}/patch/requestBody/content/application~1json/schema/properties/configs/description
#. (+2 more)
msgid ""
"This object contains various limits and settings for a customer.  Customers "
"cannot modify their own settings. Resellers can modify them for their child "
"customers. Resellers can only specify products they have already purchased. "
"If you have special requirements for your account, please contact our "
"support team."
msgstr ""
"此对象包含客户的各种限制和设置。客户不能修改自己的设置。代理商可以为其子客户"
"修改这些设置。代理商只能指定其已购买的产品。如果您的账户有特殊需求，请联系我"
"们的技术支持团队。"

#. /paths/~1ngadmin~1customers~1{id}/get/responses/200/content/application~1json/schema/properties/configs/properties/apiRate/description
#. /paths/~1ngadmin~1customers~1{id}/patch/responses/200/content/application~1json/schema/properties/configs/properties/apiRate/description
#. /paths/~1ngadmin~1customers~1{id}/patch/requestBody/content/application~1json/schema/properties/configs/properties/apiRate/description
#. (+2 more)
msgid ""
"Maximum number of API requests the customer can make  in any rolling 1-"
"minute window. If the customer has multiple API accounts, they share this "
"limit. Their combined requests cannot exceed the limit. "
msgstr ""
"在任意滚动的 1 分钟时间窗口内，客户可发起的 API 请求的最大数量。如果客户有多"
"个 API 账号，这些账号共享此限制，其请求总数不能超过该限制。"

#. /paths/~1ngadmin~1customers~1{id}/get/responses/200/content/application~1json/schema/properties/configs/properties/apiAccountLimit/description
#. /paths/~1ngadmin~1customers~1{id}/patch/responses/200/content/application~1json/schema/properties/configs/properties/apiAccountLimit/description
#. /paths/~1ngadmin~1customers~1{id}/patch/requestBody/content/application~1json/schema/properties/configs/properties/apiAccountLimit/description
#. (+2 more)
msgid "Maximum number of API accounts that can be created."
msgstr "可创建的 API 账号的最大数量。"

#. /paths/~1ngadmin~1customers~1{id}/get/responses/200/content/application~1json/schema/properties/configs/properties/type/description
#. /paths/~1ngadmin~1customers~1{id}/patch/responses/200/content/application~1json/schema/properties/configs/properties/type/description
#. /paths/~1ngadmin~1customers~1{id}/patch/requestBody/content/application~1json/schema/properties/configs/properties/type/description
#. (+2 more)
msgid ""
"Type of customer account.  Resellers can only create customer accounts of "
"type 'regular'."
msgstr "客户账户的类型。代理商只能创建类型为 'regular' 的客户账户。"

#. /paths/~1ngadmin~1customers~1{id}/get/responses/200/content/application~1json/schema/properties/configs/properties/products/description
#. /paths/~1ngadmin~1customers~1{id}/patch/responses/200/content/application~1json/schema/properties/configs/properties/products/description
#. /paths/~1ngadmin~1customers~1{id}/patch/requestBody/content/application~1json/schema/properties/configs/properties/products/description
#. (+2 more)
msgid ""
"Products enabled for the customer. \"CDN\" representing CDN Pro, and \"HDT\" "
"representing High-Speed Data Transmission are supported. "
msgstr ""
"为客户开通的产品。支持 \"CDN\"（代表 CDN Pro）和 \"HDT\"（代表高速数据传"
"输）。"

#. /paths/~1ngadmin~1customers~1{id}/get/responses/200/content/application~1json/schema/properties/configs/properties/historicalProducts/description
#. /paths/~1ngadmin~1customers~1{id}/patch/responses/200/content/application~1json/schema/properties/configs/properties/historicalProducts/description
#. /paths/~1ngadmin~1customers~1{id}/patch/requestBody/content/application~1json/schema/properties/configs/properties/historicalProducts/description
msgid ""
"Products the customer was subscribed to previously but no longer has access "
"to. This field is for record-keeping and does not grant access to the "
"products. Only resellers can update this field for their child customers. It "
"is not supported when creating a customer."
msgstr ""
"客户以前订阅过但现在已无权使用的产品。此字段仅用于记录，不会授予产品的使用权"
"限。只有代理商可以为其子客户修改此字段。创建客户时不支持此字段。"

#. /paths/~1ngadmin~1customers~1{id}/get/responses/200/content/application~1json/schema/properties/configs/properties/status/description
#. /paths/~1ngadmin~1customers~1{id}/patch/responses/200/content/application~1json/schema/properties/configs/properties/status/description
#. /paths/~1ngadmin~1customers~1{id}/patch/requestBody/content/application~1json/schema/properties/configs/properties/status/description
#. (+2 more)
msgid ""
"Account status. If the status is <i>suspended</i> API calls will fail with "
"status code 403 indicating they are forbidden. Portal logins will also "
"fail.  Child customers of a suspended reseller are <b>not</b> automatically "
"suspended though."
msgstr ""
"账户状态。如果状态为 <i>suspended</i>，API 调用将失败并返回状态码 403，表示被"
"禁止访问，控制台登录也将失败。不过，被暂停的代理商的子客户<b>不会</b>被自动暂"
"停。"

#. /paths/~1ngadmin~1customers~1{id}/get/responses/200/content/application~1json/schema/properties/configs/properties/description/description
#. /paths/~1ngadmin~1customers~1{id}/patch/responses/200/content/application~1json/schema/properties/configs/properties/description/description
#. /paths/~1ngadmin~1customers~1{id}/patch/requestBody/content/application~1json/schema/properties/configs/properties/description/description
#. (+2 more)
msgid "Description of the customer."
msgstr "客户的描述。"

#. /paths/~1ngadmin~1customers~1{id}/get/responses/200/content/application~1json/schema/properties/configs/properties/regionalOffice/description
#. /paths/~1ngadmin~1customers~1{id}/patch/responses/200/content/application~1json/schema/properties/configs/properties/regionalOffice/description
#. /paths/~1ngadmin~1customers~1{id}/patch/requestBody/content/application~1json/schema/properties/configs/properties/regionalOffice/description
#. (+3 more)
msgid ""
"Regional sales office name that satisfies the regular expression [0-9a-zA-"
"Z_-]{1,28}. "
msgstr "区域销售办事处名称，须符合正则表达式 [0-9a-zA-Z_-]{1,28}。"

#. /paths/~1ngadmin~1customers~1{id}/get/responses/200/content/application~1json/schema/properties/configs/properties/parentId/description
#. /paths/~1ngadmin~1customers~1{id}/patch/responses/200/content/application~1json/schema/properties/configs/properties/parentId/description
#. /paths/~1ngadmin~1customers~1{id}/patch/requestBody/content/application~1json/schema/properties/configs/properties/parentId/description
#. (+2 more)
msgid ""
"ID of the parent customer.  Resellers can omit this field when creating a "
"customer. It will be filled in automatically."
msgstr "父客户的 ID。代理商创建客户时可以省略此字段，系统将自动填写。"

#. /paths/~1ngadmin~1customers~1{id}/get/responses/200/content/application~1json/schema/properties/configs/properties/contactLimit/description
#. /paths/~1ngadmin~1customers~1{id}/patch/responses/200/content/application~1json/schema/properties/configs/properties/contactLimit/description
#. /paths/~1ngadmin~1customers~1{id}/patch/requestBody/content/application~1json/schema/properties/configs/properties/contactLimit/description
#. (+2 more)
msgid "Number of portal user accounts the customer is permitted to have."
msgstr "客户允许拥有的控制台用户账户数量。"

#. /paths/~1ngadmin~1customers~1{id}/get/responses/200/content/application~1json/schema/properties/configs/properties/apiMaxBurst/description
#. /paths/~1ngadmin~1customers~1{id}/patch/responses/200/content/application~1json/schema/properties/configs/properties/apiMaxBurst/description
#. /paths/~1ngadmin~1customers~1{id}/patch/requestBody/content/application~1json/schema/properties/configs/properties/apiMaxBurst/description
#. (+2 more)
msgid ""
"This value works with the <i>apiRate</i> setting to limit the number of API "
"calls that can be made by the customer. We use the <a href=\"https://"
"en.wikipedia.org/wiki/Token_bucket\">token bucket algorithm</a>. ApiMaxBurst "
"is the bucket size. If the customer has multiple API accounts, they share "
"this bucket."
msgstr ""
"此值与 <i>apiRate</i> 设置配合使用，以限制客户可发起的 API 调用次数。我们采用"
"<a href=\"https://en.wikipedia.org/wiki/Token_bucket\">令牌桶算法</a>，"
"ApiMaxBurst 即为令牌桶的大小。如果客户有多个 API 账号，这些账号共享此令牌桶。"

#. /paths/~1ngadmin~1customers~1{id}/get/responses/200/content/application~1json/schema/properties/portalSettings/title
#. /paths/~1ngadmin~1customers~1{id}/patch/responses/200/content/application~1json/schema/properties/portalSettings/title
#. /paths/~1ngadmin~1customers~1{id}/patch/requestBody/content/application~1json/schema/properties/portalSettings/title
#. (+2 more)
msgid "customerPortalSettings"
msgstr "customerPortalSettings"

#. /paths/~1ngadmin~1customers~1{id}/get/responses/200/content/application~1json/schema/properties/portalSettings/description
#. /paths/~1ngadmin~1customers~1{id}/patch/responses/200/content/application~1json/schema/properties/portalSettings/description
#. /paths/~1ngadmin~1customers~1{id}/patch/requestBody/content/application~1json/schema/properties/portalSettings/description
#. (+2 more)
msgid "These settings apply to your users accessing the CDN Pro portal."
msgstr "这些设置适用于访问 CDN Pro 控制台的用户。"

#. /paths/~1ngadmin~1customers~1{id}/get/responses/200/content/application~1json/schema/properties/portalSettings/properties/enforce2fa/description
#. /paths/~1ngadmin~1customers~1{id}/patch/responses/200/content/application~1json/schema/properties/portalSettings/properties/enforce2fa/description
#. /paths/~1ngadmin~1customers~1{id}/patch/requestBody/content/application~1json/schema/properties/portalSettings/properties/enforce2fa/description
#. (+2 more)
msgid ""
"Set to <i>true</i> to use two factor authentication to improve security."
msgstr "设置为 <i>true</i> 以使用双因素认证，提高安全性。"

#. /paths/~1ngadmin~1customers~1{id}/get/responses/200/content/application~1json/schema/properties/portalSettings/properties/passwordExpirationDays/description
#. /paths/~1ngadmin~1customers~1{id}/patch/responses/200/content/application~1json/schema/properties/portalSettings/properties/passwordExpirationDays/description
#. /paths/~1ngadmin~1customers~1{id}/patch/requestBody/content/application~1json/schema/properties/portalSettings/properties/passwordExpirationDays/description
#. (+2 more)
msgid ""
"Indicates how many days a portal user's password can remain the same before "
"it must be updated. The user will be emailed a warning in advance of the "
"expiration."
msgstr ""
"表示控制台用户的密码最多可保持多少天不变，到期前必须更新。密码过期前，系统会"
"提前通过电子邮件向用户发送提醒。"

#. /paths/~1ngadmin~1customers~1{id}/get/responses/200/content/application~1json/schema/properties/portalSettings/properties/logoutIdleTime/description
#. /paths/~1ngadmin~1customers~1{id}/patch/responses/200/content/application~1json/schema/properties/portalSettings/properties/logoutIdleTime/description
#. /paths/~1ngadmin~1customers~1{id}/patch/requestBody/content/application~1json/schema/properties/portalSettings/properties/logoutIdleTime/description
#. (+2 more)
msgid ""
"Number of seconds the portal user can be idle before being automatically "
"logged out."
msgstr "控制台用户空闲多少秒后将被自动登出。"

#. /paths/~1ngadmin~1customers~1{id}/get/responses/200/content/application~1json/schema/properties/portalSettings/properties/ipWhiteList/description
#. /paths/~1ngadmin~1customers~1{id}/patch/responses/200/content/application~1json/schema/properties/portalSettings/properties/ipWhiteList/description
#. /paths/~1ngadmin~1customers~1{id}/patch/requestBody/content/application~1json/schema/properties/portalSettings/properties/ipWhiteList/description
#. (+2 more)
msgid ""
"List of IP addresses from which portal users can log in.  You can specify a "
"range, an individual IP address, or an IP in CIDR notation. Compressed and "
"uncompressed IPv6 addresses are also permitted. Example: "
"<code>[\"1.1.1.1-1.1.1.8\", \"1.2.3.4\", \"1.5.5.0/24\"]</code>  The default "
"is [\"0.0.0.0/0\", \"::/0\"], which permits logins from all IP addresses. "
"For security, we strongly recommend specifying appropriate IP addresses in "
"your company. Child customers of a reseller can modify this setting to meet "
"their requirements."
msgstr ""
"允许控制台用户登录的 IP 地址列表。您可以指定 IP 范围、单个 IP 地址或 CIDR 格"
"式的 IP，也可以使用压缩和非压缩格式的 IPv6 地址。示例："
"<code>[\"1.1.1.1-1.1.1.8\", \"1.2.3.4\", \"1.5.5.0/24\"]</code>。默认值为 "
"[\"0.0.0.0/0\", \"::/0\"]，即允许从所有 IP 地址登录。为了安全起见，我们强烈建"
"议您指定贵公司的相应 IP 地址。代理商的子客户可以根据自身需求修改此设置。"

#. /paths/~1ngadmin~1customers~1{id}/get/responses/200/content/application~1json/schema/properties/ipWhiteList/description
#. /paths/~1ngadmin~1customers~1{id}/patch/responses/200/content/application~1json/schema/properties/ipWhiteList/description
msgid ""
"List of IP addresses from which API calls using API accounts are permitted. "
"This list works with each <a href=\"/apidocs/api-account-management/post-"
"ngadmin-apiaccounts\">API account</a>'s individual IP list.  You can specify "
"a range, an individual IP address, or an IP in CIDR notation. Compressed and "
"uncompressed IPv6 addresses are also permitted. Example: "
"<code>[\"1.1.1.1-1.1.1.8\", \"1.2.3.4\", \"1.5.5.0/24\"]</code>  The default "
"is [\"0.0.0.0/0\",\"::/0\"], which permits API calls from all IP addresses. "
"For security, we strongly recommend specifying appropriate IP addresses for "
"your company. API calls from forbidden IPs would get an HTTP 403 response "
"with a body <code>{\"code\" : \"AccessDenied\", \"message\" : \"This request "
"is rejected due to IP restriction.\"}</code>.\n"
"\n"
msgstr ""
"允许使用 API 账号发起 API 调用的 IP 地址列表。此列表与每个 <a href=\"/"
"apidocs/api-account-management/post-ngadmin-apiaccounts\">API 账号</a>各自的 "
"IP 列表配合使用。您可以指定 IP 范围、单个 IP 地址或 CIDR 格式的 IP，也可以使"
"用压缩和非压缩格式的 IPv6 地址。示例：<code>[\"1.1.1.1-1.1.1.8\", "
"\"1.2.3.4\", \"1.5.5.0/24\"]</code>。默认值为 [\"0.0.0.0/0\",\"::/0\"]，即允"
"许来自所有 IP 地址的 API 调用。为了安全起见，我们强烈建议您指定贵公司的相应 "
"IP 地址。来自被禁止 IP 的 API 调用将收到 HTTP 403 响应，响应体为 "
"<code>{\"code\" : \"AccessDenied\", \"message\" : \"This request is rejected "
"due to IP restriction.\"}</code>。\n"
"\n"

#. /paths/~1ngadmin~1customers~1{id}/get/responses/200/content/application~1json/schema/properties/chinaBizInfo/title
#. /paths/~1ngadmin~1customers~1{id}/patch/responses/200/content/application~1json/schema/properties/chinaBizInfo/title
#. /paths/~1ngadmin~1customers~1{id}/patch/requestBody/content/application~1json/schema/properties/chinaBizInfo/title
#. (+1 more)
msgid "chinaBizInfo"
msgstr "chinaBizInfo"

#. /paths/~1ngadmin~1customers~1{id}/get/responses/200/content/application~1json/schema/properties/chinaBizInfo/description
#. /paths/~1ngadmin~1customers~1{id}/patch/responses/200/content/application~1json/schema/properties/chinaBizInfo/description
#. /paths/~1ngadmin~1customers~1{id}/patch/requestBody/content/application~1json/schema/properties/chinaBizInfo/description
#. (+1 more)
msgid ""
"This object contains information that is required if the customer plans to "
"deploy to PoPs in mainland China."
msgstr "如果客户计划部署到中国大陆的 PoP 节点，则需要提供此对象中的信息。"

#. /paths/~1ngadmin~1customers~1{id}/get/responses/200/content/application~1json/schema/properties/chinaBizInfo/properties/category/description
#. /paths/~1ngadmin~1customers~1{id}/patch/responses/200/content/application~1json/schema/properties/chinaBizInfo/properties/category/description
#. /paths/~1ngadmin~1customers~1{id}/patch/requestBody/content/application~1json/schema/properties/chinaBizInfo/properties/category/description
#. (+1 more)
msgid ""
"The category indicates the type of customer:\n"
"<table>\n"
"<tr><th>Category</th><th>Description</th></tr>\n"
"<tr><td>1</td><td>military</td></tr>\n"
"<tr><td>2</td><td>government</td></tr>\n"
"<tr><td>3</td><td>insititution</td></tr>\n"
"<tr><td>4</td><td>business</td></tr>\n"
"<tr><td>5</td><td>person</td></tr>\n"
"<tr><td>6</td><td>social group</td></tr>\n"
"<tr><td>999</td><td>others</td></tr>\n"
"</table>"
msgstr ""
"category 表示客户的类型：\n"
"<table>\n"
"<tr><th>类别</th><th>描述</th></tr>\n"
"<tr><td>1</td><td>军队</td></tr>\n"
"<tr><td>2</td><td>政府机关</td></tr>\n"
"<tr><td>3</td><td>事业单位</td></tr>\n"
"<tr><td>4</td><td>企业</td></tr>\n"
"<tr><td>5</td><td>个人</td></tr>\n"
"<tr><td>6</td><td>社会团体</td></tr>\n"
"<tr><td>999</td><td>其他</td></tr>\n"
"</table>"

#. /paths/~1ngadmin~1customers~1{id}/get/responses/200/content/application~1json/schema/properties/chinaBizInfo/properties/idType/description
#. /paths/~1ngadmin~1customers~1{id}/patch/responses/200/content/application~1json/schema/properties/chinaBizInfo/properties/idType/description
#. /paths/~1ngadmin~1customers~1{id}/patch/requestBody/content/application~1json/schema/properties/chinaBizInfo/properties/idType/description
#. (+1 more)
msgid ""
"The idType field indicates a type of ID for the customer. Its value must be "
"specified in the idNumber field.\n"
"<table>\n"
"<tr><th>idType </th><th>Description</th></tr>\n"
"<tr><td>1</td><td>business license number</td></tr>\n"
"<tr><td>2</td><td>ID card</td></tr>\n"
"<tr><td>3</td><td>license of organization code</td></tr>\n"
"<tr><td>4</td><td>certificate of business corporation</td></tr>\n"
"<tr><td>5</td><td>army code</td></tr>\n"
"<tr><td>6</td><td>social group legal person certificate</td></tr>\n"
"<tr><td>7</td><td>passport</td></tr>\n"
"<tr><td>8</td><td>military ID</td></tr>\n"
"<tr><td>9</td><td>mainland travel permit for Taiwan residents</td></tr>\n"
"<tr><td>999</td><td>others</td></tr>\n"
"</table>"
msgstr ""
"idType 字段表示客户的证件类型，证件号码必须在 idNumber 字段中指定。\n"
"<table>\n"
"<tr><th>idType </th><th>描述</th></tr>\n"
"<tr><td>1</td><td>工商营业执照号码</td></tr>\n"
"<tr><td>2</td><td>身份证</td></tr>\n"
"<tr><td>3</td><td>组织机构代码证</td></tr>\n"
"<tr><td>4</td><td>事业法人证书</td></tr>\n"
"<tr><td>5</td><td>部队代号</td></tr>\n"
"<tr><td>6</td><td>社团法人证书</td></tr>\n"
"<tr><td>7</td><td>护照</td></tr>\n"
"<tr><td>8</td><td>军官证</td></tr>\n"
"<tr><td>9</td><td>台湾居民来往大陆通行证</td></tr>\n"
"<tr><td>999</td><td>其他</td></tr>\n"
"</table>"

#. /paths/~1ngadmin~1customers~1{id}/get/responses/200/content/application~1json/schema/properties/chinaBizInfo/properties/idNumber/description
#. /paths/~1ngadmin~1customers~1{id}/patch/responses/200/content/application~1json/schema/properties/chinaBizInfo/properties/idNumber/description
#. /paths/~1ngadmin~1customers~1{id}/patch/requestBody/content/application~1json/schema/properties/chinaBizInfo/properties/idNumber/description
#. (+1 more)
msgid ""
"An ID number corresponding to the idType that was specified. For example, if "
"idType is 'passport', the idNumber field should be set to the passport "
"number."
msgstr ""
"与所指定的 idType 对应的证件号码。例如，如果 idType 为 'passport'，则 "
"idNumber 字段应设置为护照号码。"

#. /paths/~1ngadmin~1customers~1{id}/get/responses/200/content/application~1json/schema/properties/language/description
#. /paths/~1ngadmin~1customers~1{id}/patch/responses/200/content/application~1json/schema/properties/language/description
#. /paths/~1ngadmin~1customers~1{id}/patch/requestBody/content/application~1json/schema/properties/language/description
#. (+1 more)
msgid ""
"Indicates the preferred language used in notification messages. A user can "
"log into the console and set a personal preferred language.\n"
"<br/>\n"
"<table>\n"
"<tr><th>Value</th><th>Language</th></tr>\n"
"<tr><td>en</td><td>English</td></tr>\n"
"<tr><td>cn</td><td>Chinese</td></tr>\n"
"<tr><td>jp</td><td>Japanese</td></tr>\n"
"<tr><td>kr</td><td>Korean</td></tr>\n"
"</table>"
msgstr ""
"表示通知消息首选使用的语言。用户可以登录控制台设置个人首选语言。\n"
"<br/>\n"
"<table>\n"
"<tr><th>值</th><th>语言</th></tr>\n"
"<tr><td>en</td><td>英文</td></tr>\n"
"<tr><td>cn</td><td>中文</td></tr>\n"
"<tr><td>jp</td><td>日文</td></tr>\n"
"<tr><td>kr</td><td>韩文</td></tr>\n"
"</table>"

#. /paths/~1ngadmin~1customers~1{id}/get/responses/200/content/application~1json/schema/properties/emailAddress/description
#. /paths/~1ngadmin~1customers~1{id}/patch/responses/200/content/application~1json/schema/properties/emailAddress/description
#. /paths/~1ngadmin~1customers/post/requestBody/content/application~1json/schema/properties/emailAddress/description
#. (+1 more)
msgid "Email address for the customer."
msgstr "客户的电子邮件地址。"

#. /paths/~1ngadmin~1customers~1{id}/get/responses/404/description
#. /paths/~1ngadmin~1customers~1{id}/patch/responses/404/description
msgid "Invalid customer."
msgstr "无效的客户。"

#. /paths/~1ngadmin~1customers~1{id}/get/description
msgid "Obtain configuration details for a customer."
msgstr "获取客户的配置详情。"

#. /paths/~1ngadmin~1customers~1{id}/patch/summary
msgid "Update a customer"
msgstr "修改客户"

#. /paths/~1ngadmin~1customers~1{id}/patch/responses/200/description
msgid ""
"The customer account was updated successfully. The response body will "
"contain the current settings."
msgstr "客户账户已成功修改。响应体将包含当前设置。"

#. /paths/~1ngadmin~1customers~1{id}/patch/responses/403/description
msgid "The API call was forbidden. Refer to the response body for details."
msgstr "API 调用被禁止。详情请参阅响应体。"

#. /paths/~1ngadmin~1customers~1{id}/patch/description
msgid ""
"Update a customer account. Settings within the <i>configs</i> field can only "
"be set by a reseller on behalf of a child customer. A child customer's "
"access to a product can only be removed if they are not currently using "
"resources. For example, the child should not have any remaining deployed "
"properties."
msgstr ""
"修改客户账号。<i>configs</i> 字段中的设置只能由代理商代表子客户进行设置。只有"
"当子客户当前未使用相关资源时，才能移除其对某个产品的访问权限。例如，该子客户"
"不应还有已部署的加速项目。"

#. /paths/~1ngadmin~1customers~1{id}/patch/requestBody/content/application~1json/schema/properties/apiKey/description
msgid ""
"If specified, the value must be \"reset\". A new key will be generated for "
"the administrator API account and must be used for all future API calls "
"using that account."
msgstr ""
"如果指定，值必须为 \"reset\"。系统将为管理员 API 账号生成新的密钥，此后使用该"
"账号的所有 API 调用都必须使用新密钥。"

#. /paths/~1ngadmin~1customers~1{id}/patch/requestBody/content/application~1json/schema/properties/ipWhiteList/description
msgid ""
"List of IP addresses from which API calls using API accounts are permitted. "
"This list works with each <a href=\"/apidocs/api-account-management/post-"
"ngadmin-apiaccounts\">API account</a>'s individual IP list. You can specify "
"a range, an individual IP address, or an IP in CIDR notation. Compressed and "
"uncompressed IPv6 addresses are also permitted. Example: "
"<code>[\"1.1.1.1-1.1.1.8\", \"1.2.3.4\", \"1.5.5.0/24\"]</code>  The default "
"is [\"0.0.0.0/0\",\"::/0\"], which permits API calls from all IP addresses.  "
"For security, we strongly recommend specifying appropriate IP addresses in "
"your company. Child customers of a reseller can modify this setting to meet "
"their requirements.  API calls from forbidden IPs would get an HTTP 403 "
"response with a body <code>{\"code\" : \"AccessDenied\", \"message\" : "
"\"This request is rejected due to IP restriction.\"}</code>."
msgstr ""
"允许使用 API 账号发起 API 调用的 IP 地址列表。此列表与每个 <a href=\"/"
"apidocs/api-account-management/post-ngadmin-apiaccounts\">API 账号</a>各自的 "
"IP 列表配合使用。您可以指定 IP 范围、单个 IP 地址或 CIDR 格式的 IP，也可以使"
"用压缩和非压缩格式的 IPv6 地址。示例：<code>[\"1.1.1.1-1.1.1.8\", "
"\"1.2.3.4\", \"1.5.5.0/24\"]</code>。默认值为 [\"0.0.0.0/0\",\"::/0\"]，即允"
"许来自所有 IP 地址的 API 调用。为了安全起见，我们强烈建议您指定贵公司的相应 "
"IP 地址。代理商的子客户可以根据自身需求修改此设置。来自被禁止 IP 的 API 调用"
"将收到 HTTP 403 响应，响应体为 <code>{\"code\" : \"AccessDenied\", "
"\"message\" : \"This request is rejected due to IP restriction.\"}</code>。"

#. /paths/~1ngadmin~1customers~1{id}/patch/requestBody/content/application~1json/schema/properties/emailAddress/description
msgid "Email address of the customer."
msgstr "客户的电子邮件地址。"

#. /paths/~1ngadmin~1customers~1{id}/patch/requestBody/description
msgid ""
"Specify the fields to be updated.  Omitted fields will be unchanged. "
"Settings within the <i>configs</i> field can only be set by a reseller on "
"behalf of a child customer."
msgstr ""
"指定要修改的字段，省略的字段将保持不变。<i>configs</i> 字段中的设置只能由代理"
"商代表子客户进行设置。"

#. /paths/~1ngadmin~1customers~1{id}/delete/summary
msgid "Delete a customer"
msgstr "删除客户"

#. /paths/~1ngadmin~1customers~1{id}/delete/responses/204/description
msgid "The customer was deleted."
msgstr "客户已删除。"

#. /paths/~1ngadmin~1customers~1{id}/delete/responses/404/description
msgid "The customer could not be found."
msgstr "找不到该客户。"

#. /paths/~1ngadmin~1customers~1{id}/delete/responses/409/description
msgid ""
"The customer could not be deleted because it is still configured with a "
"product. <a href=\"/apidocs/customer-management/patch-ngadmin-customers-"
"id\">Update the customer</a> to remove the product before trying again."
msgstr ""
"无法删除该客户，因为该客户仍配置有产品。请先<a href=\"/apidocs/customer-"
"management/patch-ngadmin-customers-id\">修改客户</a>以移除产品，然后重试。"

#. /paths/~1ngadmin~1customers~1{id}/delete/description
msgid ""
"In the past, resellers could use this API to delete a child customer. This "
"API has been deprecated. A reseller can instead disable a child customer by "
"<a href=\"/apidocs/customer-management/patch-ngadmin-customers-id\">updating "
"the customer</a>'s configuration to remove its products and modifying its "
"status to \"suspended\".\n"
msgstr ""
"过去，代理商可以使用此 API 删除子客户。此 API 现已弃用。代理商可以改为通过<a "
"href=\"/apidocs/customer-management/patch-ngadmin-customers-id\">修改客户</a>"
"配置来停用子客户：移除其产品，并将其状态修改为 \"suspended\"。\n"

#. /paths/~1ngadmin~1customers/post/summary
msgid "Create a customer"
msgstr "创建客户"

#. /paths/~1ngadmin~1customers/post/responses/201/description
msgid ""
"The customer was successfully created. The response body will have details "
"including default values of settings not explicitly specified in the request "
"body including the API key. Resellers can give the API name and key to their "
"customer to allow them to manage their CDN use by calling APIs.\n"
"The Location header will also include a URL to the customer account. "
"Example: <code>Location: https://ngapi.{{siteDomain}}/ngadmin/customers/"
"12345678</code>"
msgstr ""
"客户已成功创建。响应体将包含详细信息，包括请求体中未明确指定的设置的默认值以"
"及 API 密钥。代理商可以将 API 名称和密钥提供给其客户，使客户能够通过调用 API "
"管理其 CDN 使用。\n"
"Location 头中还将包含客户账户的 URL。示例：<code>Location: https://ngapi."
"{{siteDomain}}/ngadmin/customers/12345678</code>"

#. /paths/~1ngadmin~1customers/post/responses/201/content/application~1json/schema/properties/customerId/description
msgid "ID of the new customer."
msgstr "新客户的 ID。"

#. /paths/~1ngadmin~1customers/post/responses/201/content/application~1json/schema/properties/apiKey/description
msgid "API key corresponding to the administrator API account."
msgstr "与管理员 API 账号对应的 API 密钥。"

#. /paths/~1ngadmin~1customers/post/responses/201/content/application~1json/schema/properties/responsiblePerson/description
msgid "Name of a person responsible for the customer account.\n"
msgstr "客户账户负责人的姓名。\n"

#. /paths/~1ngadmin~1customers/post/responses/201/content/application~1json/schema/properties/configs/title
#. /paths/~1ngadmin~1customers/post/requestBody/content/application~1json/schema/properties/configs/title
msgid "customerConfigs"
msgstr "customerConfigs"

#. /paths/~1ngadmin~1customers/post/responses/201/content/application~1json/schema/properties/ipWhiteList/description
msgid ""
"List of IP addresses from which API calls using API accounts are permitted.  "
"You can specify a range, an individual IP address, or an IP in CIDR "
"notation.  Example: <code>[\"1.1.1.1-1.1.1.8\", \"1.2.3.4\", "
"\"1.5.5.0/24\"]</code>  The default is [\"0.0.0.0/0\"], which permits API "
"calls from all IP addresses. For security, we strongly recommend specifying "
"appropriate IP addresses for your company.\n"
msgstr ""
"允许使用 API 账号发起 API 调用的 IP 地址列表。您可以指定 IP 范围、单个 IP 地"
"址或 CIDR 格式的 IP。示例：<code>[\"1.1.1.1-1.1.1.8\", \"1.2.3.4\", "
"\"1.5.5.0/24\"]</code>。默认值为 [\"0.0.0.0/0\"]，即允许来自所有 IP 地址的 "
"API 调用。为了安全起见，我们强烈建议您指定贵公司的相应 IP 地址。\n"

#. /paths/~1ngadmin~1customers/post/responses/201/content/application~1json/schema/properties/phone/description
#. /paths/~1ngadmin~1customers/post/requestBody/content/application~1json/schema/properties/phone/description
msgid "A phone number for the customer."
msgstr "客户的电话号码。"

#. /paths/~1ngadmin~1customers/post/responses/201/headers/Location/description
msgid ""
"URL of the new customer. The URL follows this format: https://ngapi."
"{{siteDomain}}/ngadmin/customers/{customerId} where {customerId} represents "
"the ID of the newly created customer. If you would like to get the customer "
"ID, simply extract the last portion of the path and ignore the rest. The ID "
"can be used to query or update the customer."
msgstr ""
"新客户的 URL。URL 格式如下：https://ngapi.{{siteDomain}}/ngadmin/customers/"
"{customerId}，其中 {customerId} 表示新创建客户的 ID。如果您想获取客户 ID，只"
"需提取路径的最后一部分，忽略其余部分即可。该 ID 可用于查询或修改该客户。"

#. /paths/~1ngadmin~1customers/post/description
msgid ""
"Resellers can use this API to create a child customer. If the customer "
"requires deployment to PoPs in mainland China the reseller is responsible "
"for collecting and verifying the <i>phone</i>, <i>address</i>, "
"<i>responsiblePerson</i>, and <i>chinaBizInfo</i> fields for the customer "
"before enabling deployment to China."
msgstr ""
"代理商可以使用此 API 创建子客户。如果客户需要部署到中国大陆的 PoP，代理商在为"
"其开通中国大陆部署之前，负责收集并核实该客户的 <i>phone</i>、<i>address</i>、"
"<i>responsiblePerson</i> 和 <i>chinaBizInfo</i> 字段。"

#. /paths/~1ngadmin~1customers/post/requestBody/content/application~1json/schema/properties/responsiblePerson/description
#. /paths/~1ngadmin~1customers/get/responses/200/content/application~1json/schema/properties/customers/items/properties/responsiblePerson/description
msgid "Name of a person responsible for the customer account."
msgstr "客户账户负责人的姓名。"

#. /paths/~1ngadmin~1customers/post/requestBody/content/application~1json/schema/properties/ipWhiteList/description
msgid ""
"List of IP addresses from which API calls using API accounts are permitted. "
"This list works with each <a href=\"/apidocs/api-account-management/post-"
"ngadmin-apiaccounts\">API account</a>'s individual IP list.  You can specify "
"a range, an individual IP address, or an IP in CIDR notation. Compressed and "
"uncompressed IPv6 addresses are also permitted. Example: "
"<code>[\"1.1.1.1-1.1.1.8\", \"1.2.3.4\", \"1.5.5.0/24\"]</code>  The default "
"is [\"0.0.0.0/0\", \"::/0\"], which permits API calls from all IP addresses. "
"For security, we strongly recommend specifying appropriate IP addresses in "
"your company. Child customers of a reseller can modify this setting to meet "
"their requirements. API calls from forbidden IPs would get an HTTP 403 "
"response with a body <code>{\"code\" : \"AccessDenied\", \"message\" : "
"\"This request is rejected due to IP restriction.\"}</code>.\n"
msgstr ""
"允许使用 API 账号发起 API 调用的 IP 地址列表。此列表与每个 <a href=\"/"
"apidocs/api-account-management/post-ngadmin-apiaccounts\">API 账号</a>各自的 "
"IP 列表配合使用。您可以指定 IP 范围、单个 IP 地址或 CIDR 格式的 IP，也可以使"
"用压缩和非压缩格式的 IPv6 地址。示例：<code>[\"1.1.1.1-1.1.1.8\", "
"\"1.2.3.4\", \"1.5.5.0/24\"]</code>。默认值为 [\"0.0.0.0/0\", \"::/0\"]，即允"
"许来自所有 IP 地址的 API 调用。为了安全起见，我们强烈建议您指定贵公司的相应 "
"IP 地址。代理商的子客户可以根据自身需求修改此设置。来自被禁止 IP 的 API 调用"
"将收到 HTTP 403 响应，响应体为 <code>{\"code\" : \"AccessDenied\", "
"\"message\" : \"This request is rejected due to IP restriction.\"}</code>。\n"

#. /paths/~1ngadmin~1customers/post/requestBody/description
msgid "The request body describes the new customer account."
msgstr "请求体描述新的客户账户。"

#. /paths/~1ngadmin~1customers/get/summary
msgid "Get list of customers"
msgstr "获取客户列表"

#. /paths/~1ngadmin~1customers/get/responses/200/description
msgid "The response contains a list of customers."
msgstr "响应包含客户列表。"

#. /paths/~1ngadmin~1customers/get/responses/200/content/application~1json/schema/properties/count/description
msgid "Number of customers."
msgstr "客户数量。"

#. /paths/~1ngadmin~1customers/get/responses/200/content/application~1json/schema/properties/customers/description
msgid "List of customers."
msgstr "客户列表。"

#. /paths/~1ngadmin~1customers/get/responses/200/content/application~1json/schema/properties/customers/items/description
msgid "Summarizes a single customer account."
msgstr "单个客户账户的摘要信息。"

#. /paths/~1ngadmin~1customers/get/responses/200/content/application~1json/schema/properties/customers/items/properties/customerId/description
msgid ""
"Customer ID. Pass it to the <a href=\"/apidocs/customer-management/get-"
"ngadmin-customers-id\">Get Customer Details API</a> to retrieve more "
"information."
msgstr ""
"客户 ID。将其传给<a href=\"/apidocs/customer-management/get-ngadmin-"
"customers-id\">获取客户详情 API</a> 可获取更多信息。"

#. /paths/~1ngadmin~1customers/get/responses/200/content/application~1json/schema/properties/customers/items/properties/parentId/description
msgid "ID of the parent customer."
msgstr "父客户的 ID。"

#. /paths/~1ngadmin~1customers/get/responses/200/content/application~1json/schema/properties/customers/items/properties/name/description
msgid "Name of the customer."
msgstr "客户名称。"

#. /paths/~1ngadmin~1customers/get/responses/200/content/application~1json/schema/properties/customers/items/properties/status/description
msgid "Account status."
msgstr "账户状态。"

#. /paths/~1ngadmin~1customers/get/responses/200/content/application~1json/schema/properties/customers/items/properties/creationTime/description
msgid "RFC 3339 date indicating when the customer account was created."
msgstr "RFC 3339 格式的日期，表示客户账户的创建时间。"

#. /paths/~1ngadmin~1customers/get/responses/200/content/application~1json/schema/properties/customers/items/properties/lastUpdateTime/description
msgid "RFC 3339 date indicating when the customer account was last updated."
msgstr "RFC 3339 格式的日期，表示客户账户的最后修改时间。"

#. /paths/~1ngadmin~1customers/get/responses/200/content/application~1json/schema/properties/customers/items/properties/type/description
msgid "Indicates the type of account."
msgstr "表示账户的类型。"

#. /paths/~1ngadmin~1customers/get/responses/200/content/application~1json/schema/properties/customers/items/properties/phone/description
msgid "Phone number of the customer."
msgstr "客户的电话号码。"

#. /paths/~1ngadmin~1customers/get/responses/200/content/application~1json/schema/properties/customers/items/properties/products/description
msgid "List of products that the customer has access to."
msgstr "客户有权使用的产品列表。"

#. /paths/~1ngadmin~1customers/get/responses/403/description
msgid "The API call is not permitted."
msgstr "不允许此 API 调用。"

#. /paths/~1ngadmin~1customers/get/description
msgid ""
"<b>Resellers</b> can use this API to get a list of their child customers. "
"Query parameters filter results.\n"
msgstr ""
"<b>代理商</b>可以使用此 API 获取其子客户列表。可通过查询参数筛选结果。\n"

#. /paths/~1ngadmin~1customers/get/parameters/1/description
msgid ""
"Maximum number of customers to return. The default is to return all "
"customers."
msgstr "返回客户的最大数量。默认返回所有客户。"

#. /paths/~1ngadmin~1customers/get/parameters/2/description
msgid ""
"Keyword to search for in the customerId, apiName, name, and description "
"fields of customer accounts."
msgstr ""
"在客户账户的 customerId、apiName、name 和 description 字段中搜索的关键字。"

#. /paths/~1ngadmin~1customers/get/parameters/3/description
msgid "Comma-separated list of IDs of customers to return."
msgstr "要返回的客户的 ID 列表，以逗号分隔。"

#. /paths/~1ngadmin~1customers/get/parameters/4/description
msgid "Return customers with particular status."
msgstr "返回具有特定状态的客户。"

#. /paths/~1ngadmin~1customers/get/parameters/5/description
msgid ""
"Comma-separated list of products which can include 'CDN' representing CDN "
"Pro and 'HDT' representing High-Speed Data Transmission'. Only customers "
"with access to the specified products will be returned."
msgstr ""
"以逗号分隔的产品列表，可包括 'CDN'（代表 CDN Pro）和 'HDT'（代表高速数据传"
"输）。仅返回有权使用指定产品的客户。"

#. /paths/~1ngadmin~1customers/get/parameters/6/description
msgid ""
"This parameter is processed only when <i>products</i> is also specified. If "
"true, a customer is considered a match when a specified product is in either "
"the customer's <i>configs.products</i> or <i>configs.historicalProducts</i> "
"list. If false or omitted, only <i>configs.products</i> is checked."
msgstr ""
"仅当同时指定了 <i>products</i> 时才会处理此参数。如果为 true，只要指定的产品"
"位于客户的 <i>configs.products</i> 或 <i>configs.historicalProducts</i> 列表"
"中，即视为匹配。如果为 false 或省略，则仅检查 <i>configs.products</i>。"

#. /paths/~1ngadmin~1customers/get/parameters/7/description
msgid "Sort accounts by their creation time or when they were last updated."
msgstr "按账户的创建时间或最后修改时间排序。"

#. /paths/~1ngadmin~1customers/get/parameters/8/description
msgid ""
"Order of customers returned by the API, either <i>asc</i> for ascending or "
"<i>desc</i> for descending."
msgstr "API 返回的客户的排列顺序，<i>asc</i> 表示升序，<i>desc</i> 表示降序。"

#. /paths/~1ngadmin~1customers/get/parameters/9/description
msgid ""
"Comma-separated list of regional offices of customers to return. A case "
"insensitive search for the regional offices will be done.  You can specify a "
"value ending with an asterisk character, '*', in which case all customers "
"whose regional offices begin with the preceding characters will be returned."
msgstr ""
"要返回的客户所属区域办事处列表，以逗号分隔。区域办事处的搜索不区分大小写。您"
"可以指定以星号 '*' 结尾的值，此时将返回区域办事处以星号前字符开头的所有客户。"

#. /paths/~1cdn~1clientRegions/get/summary
msgid "Get client regions"
msgstr "获取客户端区域"

#. /paths/~1cdn~1clientRegions/get/responses/200/description
msgid ""
"The response body contains a list of regions. You can specify a region's "
"code in an edge hostname's client zone rule."
msgstr "响应体包含区域列表。您可以在调度域名的客户端分区规则中指定区域代码。"

#. /paths/~1cdn~1clientRegions/get/responses/200/content/application~1json/schema/items/properties/code/description
msgid "A code representing a region."
msgstr "代表区域的代码。"

#. /paths/~1cdn~1clientRegions/get/responses/200/content/application~1json/schema/items/properties/name/description
msgid "A description of the region.\n"
msgstr "区域的描述。\n"

#. /paths/~1cdn~1clientRegions/get/description
msgid ""
"Get a list of client regions that can be used in <a href=\"/apidocs/edge-"
"hostname-management/createedgehostname\">edge hostname client zone rules</"
"a>. Query parameters allow you to filter and sort the results."
msgstr ""
"获取可在<a href=\"/apidocs/edge-hostname-management/createedgehostname\">调度"
"域名客户端区域规则</a>中使用的客户端区域列表。您可以通过查询参数筛选和排序结"
"果。"

#. /paths/~1cdn~1clientRegions/get/parameters/0/description
msgid "Return regions whose code or name contains the specified value.\n"
msgstr "返回代码或名称中包含指定值的区域。\n"

#. /paths/~1cdn~1clientRegions/get/parameters/1/description
msgid ""
"Order of client regions returned. Use 'asc' for ascending order or 'desc' "
"for descending order."
msgstr ""
"返回的客户端区域的排列顺序。使用 'asc' 表示升序，使用 'desc' 表示降序。"

#. /paths/~1cdn~1clientRegions/get/parameters/2/description
msgid ""
"Limit the returned regions to those where an ISP operates. The value should "
"be one of the ISP codes returned by the <a href=\"/apidocs/cdn-product-"
"management/get-cdn-isps\">ISPs API</a>."
msgstr ""
"将返回的区域限定为某运营商提供服务的区域。该值应为<a href=\"/apidocs/cdn-"
"product-management/get-cdn-isps\">运营商 API</a> 返回的运营商代码之一。"

#. /paths/~1ngadmin~1apicalls/get/summary
msgid "Get a list of API calls"
msgstr "获取 API 调用列表"

#. /paths/~1ngadmin~1apicalls/get/responses/200/description
msgid "The response body contains a summary of API calls that have been made."
msgstr "响应体包含已发起的 API 调用的摘要信息。"

#. /paths/~1ngadmin~1apicalls/get/responses/200/content/application~1json/schema/properties/hasMore/description
msgid ""
"Indicates whether there are more API calls available beyond the current page "
"of results."
msgstr "表示在当前结果页之外是否还有更多 API 调用。"

#. /paths/~1ngadmin~1apicalls/get/responses/200/content/application~1json/schema/properties/apiCalls/description
msgid "A list of API calls."
msgstr "API 调用列表。"

#. /paths/~1ngadmin~1apicalls/get/responses/200/content/application~1json/schema/properties/apiCalls/items/properties/apiRequestId/description
#. /paths/~1ngadmin~1apicalls~1{id}/get/responses/200/content/application~1json/schema/properties/apiRequestId/description
msgid "A unique ID representing the API call."
msgstr "代表该 API 调用的唯一 ID。"

#. /paths/~1ngadmin~1apicalls/get/responses/200/content/application~1json/schema/properties/apiCalls/items/properties/requestTimestamp/description
msgid ""
"RFC 3339 date with UTC time that indicates when the API call was made. "
"Example: \"2020-04-24T20:09:15Z\""
msgstr ""
"RFC 3339 格式的 UTC 时间，表示发起 API 调用的时间。示例："
"\"2020-04-24T20:09:15Z\""

#. /paths/~1ngadmin~1apicalls/get/responses/200/content/application~1json/schema/properties/apiCalls/items/properties/requestURL/description
msgid "URL that was requested."
msgstr "所请求的 URL。"

#. /paths/~1ngadmin~1apicalls/get/responses/200/content/application~1json/schema/properties/apiCalls/items/properties/requestMethod/description
msgid "Indicates the HTTP method that was used. Example:  \"GET\""
msgstr "表示所使用的 HTTP 方法。示例：\"GET\""

#. /paths/~1ngadmin~1apicalls/get/responses/200/content/application~1json/schema/properties/apiCalls/items/properties/isSafe/description
#. /paths/~1ngadmin~1apicalls~1{id}/get/responses/200/content/application~1json/schema/properties/isSafe/description
msgid ""
"A value of <i>true</i> indicates the API call is read-only and does not "
"modify any resource. A value of <i>false</i> means a modification can "
"occur.  For example, a call to create or deploy a property is not safe, so "
"<i>false</i> would be returned."
msgstr ""
"值为 <i>true</i> 表示该 API 调用是只读的，不会修改任何资源。值为 <i>false</"
"i> 表示可能会发生修改。例如，创建或部署加速项目的调用是不安全的，因此会返回 "
"<i>false</i>。"

#. /paths/~1ngadmin~1apicalls/get/responses/200/content/application~1json/schema/properties/apiCalls/items/properties/responseCode/description
msgid "HTTP response code for the API call."
msgstr "API 调用的 HTTP 响应码。"

#. /paths/~1ngadmin~1apicalls/get/responses/200/content/application~1json/schema/properties/apiCalls/items/properties/onBehalfOf/description
msgid ""
"A non-empty value indicates that an API call was made on your behalf. For "
"example, the CDN Pro support team may have helped you with configuration."
msgstr ""
"非空值表示该 API 调用是代表您发起的。例如，CDN Pro 技术支持团队可能协助您进行"
"了配置。"

#. /paths/~1ngadmin~1apicalls/get/responses/200/content/application~1json/schema/properties/apiCalls/items/properties/apiName/description
msgid ""
"Indicates the API account name used in the API call. This field will be "
"omitted if the admin API account is used."
msgstr ""
"表示 API 调用中使用的 API 账号名称。如果使用的是管理员 API 账号，则省略此字"
"段。"

#. /paths/~1ngadmin~1apicalls/get/responses/200/content/application~1json/schema/properties/filters/description
msgid "Echoes the query parameters used in the request."
msgstr "回显请求中使用的查询参数。"

#. /paths/~1ngadmin~1apicalls/get/responses/200/content/application~1json/schema/properties/filters/properties/method/description
msgid "The HTTP method filter applied to the request."
msgstr "请求中应用的 HTTP 方法过滤条件。"

#. /paths/~1ngadmin~1apicalls/get/responses/200/content/application~1json/schema/properties/filters/properties/path/description
msgid "The path filter applied to the request."
msgstr "请求中应用的路径过滤条件。"

#. /paths/~1ngadmin~1apicalls/get/responses/200/content/application~1json/schema/properties/filters/properties/safe/description
msgid "The safe filter applied to the request."
msgstr "请求中应用的 safe 过滤条件。"

#. /paths/~1ngadmin~1apicalls/get/responses/200/content/application~1json/schema/properties/filters/properties/caller/description
msgid "The API account name or ID filter applied to the request."
msgstr "请求中应用的 API 账号名称或 ID 过滤条件。"

#. /paths/~1ngadmin~1apicalls/get/responses/200/content/application~1json/schema/properties/filters/properties/onbehalfof/description
msgid "The on-behalf-of filter applied to the request."
msgstr "请求中应用的 on-behalf-of 过滤条件。"

#. /paths/~1ngadmin~1apicalls/get/responses/200/content/application~1json/schema/properties/filters/properties/status/description
msgid "The HTTP response status code filter applied to the request."
msgstr "请求中应用的 HTTP 响应状态码过滤条件。"

#. /paths/~1ngadmin~1apicalls/get/responses/200/content/application~1json/schema/properties/filters/properties/startdate/description
msgid "The start of the time period filter applied to the request."
msgstr "请求中应用的时间段起始过滤条件。"

#. /paths/~1ngadmin~1apicalls/get/responses/200/content/application~1json/schema/properties/filters/properties/enddate/description
msgid "The end of the time period filter applied to the request."
msgstr "请求中应用的时间段结束过滤条件。"

#. /paths/~1ngadmin~1apicalls/get/responses/200/content/application~1json/schema/properties/filters/properties/before/description
msgid ""
"The cursor ID used to retrieve API calls made before a specific API call."
msgstr "用于获取在某个特定 API 调用之前发起的 API 调用的游标 ID。"

#. /paths/~1ngadmin~1apicalls/get/responses/200/content/application~1json/schema/properties/filters/properties/limit/description
msgid "The maximum number of API calls to return."
msgstr "返回 API 调用的最大数量。"

#. /paths/~1ngadmin~1apicalls/get/description
msgid ""
"Retrieve a list of recent API calls that have been made by you or on your "
"behalf. API calls triggered by portal users are included as well. Query "
"parameters allow you to filter results. By default, API calls made in the "
"last 24 hours will be returned if the startdate and enddate parameters are "
"unspecified."
msgstr ""
"获取由您或代表您发起的近期 API 调用列表，其中也包括控制台用户触发的 API 调"
"用。您可以通过查询参数筛选结果。如果未指定 startdate 和 enddate 参数，默认返"
"回最近 24 小时内的 API 调用。"

#. /paths/~1ngadmin~1apicalls/get/parameters/0/description
msgid "Filter results by HTTP method. Example: \"PATCH\"."
msgstr "按 HTTP 方法过滤结果。示例：\"PATCH\"。"

#. /paths/~1ngadmin~1apicalls/get/parameters/1/description
msgid ""
"Specify the path portion of a URI to filter out calls to a particular path. "
"For example, to get a list of calls to property API endpoints using https://"
"ngapi.{{siteDomain}}/cdn/properties, you would specify \"path=/cdn/"
"properties\"."
msgstr ""
"指定 URI 的路径部分，以筛选出对特定路径的调用。例如，要获取对 https://ngapi."
"{{siteDomain}}/cdn/properties 加速项目 API 接口的调用列表，您可以指定 "
"\"path=/cdn/properties\"。"

#. /paths/~1ngadmin~1apicalls/get/parameters/2/description
msgid ""
"Filter results by whether they are considered safe or not. Safe calls do not "
"make changes to resources."
msgstr "按调用是否被视为安全来过滤结果。安全的调用不会修改资源。"

#. /paths/~1ngadmin~1apicalls/get/parameters/3/description
msgid ""
"Filter results by specifying the API account name or API account ID. You can "
"get IDs by obtaining a <a href=\"/apidocs/api-account-management/get-ngadmin-"
"apiaccounts\">list of your API accounts</a>."
msgstr ""
"通过指定 API 账号名称或 API 账号 ID 来过滤结果。您可以通过获取 <a href=\"/"
"apidocs/api-account-management/get-ngadmin-apiaccounts\">API 账号列表</a>得"
"到 ID。"

#. /paths/~1ngadmin~1apicalls/get/parameters/4/description
msgid ""
"The value can be a customer ID to return API calls made on behalf of that "
"customer, <i>none</i> to fetch API calls made directly or through the "
"portal, or <i>any</i> to fetch calls made on behalf of any customer. The "
"last option would apply only if you are a reseller."
msgstr ""
"该值可以是客户 ID，以返回代表该客户发起的 API 调用；也可以是 <i>none</i>，以"
"获取直接发起或通过控制台发起的 API 调用；或者是 <i>any</i>，以获取代表任意客"
"户发起的调用。最后一个选项仅适用于代理商。"

#. /paths/~1ngadmin~1apicalls/get/parameters/6/description
msgid ""
"Filter API calls by specifying a comma-separated list of HTTP response "
"status codes. You can also specify individual status codes such as \"200\" "
"or \"404\". You can also  pass \"2xx\", \"3xx\", \"4xx\", or \"5xx\" to "
"request all API calls whose response status codes begin with the first "
"digit. For example, \"2xx\" will include API calls whose status were "
"\"200\", \"201\", and \"204\"."
msgstr ""
"通过指定以逗号分隔的 HTTP 响应状态码列表来过滤 API 调用。您也可以指定单个状态"
"码，例如 \"200\" 或 \"404\"。您还可以传入 \"2xx\"、\"3xx\"、\"4xx\" 或 "
"\"5xx\"，以请求响应状态码以该数字开头的所有 API 调用。例如，\"2xx\" 将包括状"
"态码为 \"200\"、\"201\" 和 \"204\" 的 API 调用。"

#. /paths/~1ngadmin~1apicalls/get/parameters/7/description
msgid ""
"RFC 3339 format date indicating the beginning of the time period when API "
"calls were made. Example: <code>startdate=2019-10-30T00:00:00Z</code>. This "
"field should be specified along with the enddate parameter or left empty."
msgstr ""
"RFC 3339 格式的日期，表示发起 API 调用的时间段的开始时间。示例："
"<code>startdate=2019-10-30T00:00:00Z</code>。此字段应与 enddate 参数一起指"
"定，或者留空。"

#. /paths/~1ngadmin~1apicalls/get/parameters/8/description
msgid ""
"RFC 3339 date indicating the end of the time period when API calls were "
"made. Example: <code>enddate=2019-10-30T00:00:00Z</code>. This field should "
"be specified along with the startdate parameter or left empty."
msgstr ""
"RFC 3339 格式的日期，表示发起 API 调用的时间段的结束时间。示例："
"<code>enddate=2019-10-30T00:00:00Z</code>。此字段应与 startdate 参数一起指"
"定，或者留空。"

#. /paths/~1ngadmin~1apicalls/get/parameters/9/description
msgid ""
"Return API calls made before the API call with this ID. Use the "
"<code>apiRequestId</code> from a previous response to paginate through "
"results."
msgstr ""
"返回在此 ID 对应的 API 调用之前发起的 API 调用。使用上一个响应中的 "
"<code>apiRequestId</code> 对结果进行分页。"

#. /paths/~1ngadmin~1apicalls/get/parameters/10/description
msgid ""
"Maximum number of API calls to return. The default is to return up to 100 "
"calls."
msgstr "返回 API 调用的最大数量。默认最多返回 100 个调用。"

#. /paths/~1ngadmin~1apicalls/get/parameters/11/description
msgid ""
"An optional header that resellers can use to specify whether to include data "
"from children customers. <table><tr><th>Value</th><th>Behavior</th></"
"tr><tr><td>self-only</td><td>Include API calls of the caller.</td></"
"tr><tr><td>children-only</td><td>Include API calls of children customers "
"only.</td></tr><tr><td>self+children</td><td>Include API calls of both the "
"caller and children customers.</td></tr></table>"
msgstr ""
"可选请求头，代理商可用其指定是否包含子客户的数据。<table><tr><th>值</th><th>"
"行为</th></tr><tr><td>self-only</td><td>包含调用方的 API 调用。</td></"
"tr><tr><td>children-only</td><td>仅包含子客户的 API 调用。</td></"
"tr><tr><td>self+children</td><td>同时包含调用方和子客户的 API 调用。</td></"
"tr></table>"

#. /paths/~1ngadmin~1apicalls~1{id}/parameters/0/description
msgid ""
"The ID is a value returned in the Qtl-Request-Id header when making a CDN "
"Pro API call. It is also available when <a href=\"/apidocs/api-call-history/"
"get-ngadmin-apicalls\">getting a list of API calls</a>."
msgstr ""
"该 ID 是调用 CDN Pro API 时 Qtl-Request-Id 响应头中返回的值，也可以在<a "
"href=\"/apidocs/api-call-history/get-ngadmin-apicalls\">获取 API 调用列表</a>"
"时获得。"

#. /paths/~1ngadmin~1apicalls~1{id}/get/summary
msgid "Get details about an API call"
msgstr "获取 API 调用详情"

#. /paths/~1ngadmin~1apicalls~1{id}/get/responses/200/description
msgid "The response body contains details about an API call."
msgstr "响应体包含 API 调用的详细信息。"

#. /paths/~1ngadmin~1apicalls~1{id}/get/responses/200/content/application~1json/schema/properties/customerId/description
#. /paths/~1cdn~1serviceQuotas/get/responses/200/content/application~1json/schema/properties/serviceQuotaList/items/properties/customerId/description
#. /paths/~1cdn~1serviceQuotas~1{serviceQuotaId}/get/responses/200/content/application~1json/schema/properties/customerId/description
#. (+2 more)
msgid "ID of the customer."
msgstr "客户的 ID。"

#. /paths/~1ngadmin~1apicalls~1{id}/get/responses/200/content/application~1json/schema/properties/apiName/description
msgid "The API name used to make the API call."
msgstr "发起 API 调用时使用的 API 名称。"

#. /paths/~1ngadmin~1apicalls~1{id}/get/responses/200/content/application~1json/schema/properties/apiAccountId/description
msgid ""
"The ID of an API account if one other than the administrative API account "
"was used to make the API call."
msgstr "如果发起 API 调用时使用的不是管理员 API 账号，则为所用 API 账号的 ID。"

#. /paths/~1ngadmin~1apicalls~1{id}/get/responses/200/content/application~1json/schema/properties/clientIp/description
msgid "Caller's IP address."
msgstr "调用方的 IP 地址。"

#. /paths/~1ngadmin~1apicalls~1{id}/get/responses/200/content/application~1json/schema/properties/requestHeaders/description
msgid ""
"An array of all the request headers passed in the API call. Each entry "
"consists of the header along with its value. Example: \"Content-"
"Type:application/json;charset=UTF-8\"."
msgstr ""
"API 调用中传递的所有请求头组成的数组。每个条目由请求头及其值组成。示例："
"\"Content-Type:application/json;charset=UTF-8\"。"

#. /paths/~1ngadmin~1apicalls~1{id}/get/responses/200/content/application~1json/schema/properties/requestBody/description
msgid "Body of the HTTP request."
msgstr "HTTP 请求的请求体。"

#. /paths/~1ngadmin~1apicalls~1{id}/get/responses/200/content/application~1json/schema/properties/requestTimestamp/description
msgid ""
"RFC 3339 date indicating when the API call was made. Example: "
"\"2020-04-24T15:21:17Z\" "
msgstr ""
"RFC 3339 格式的日期，表示发起 API 调用的时间。示例：\"2020-04-24T15:21:17Z\""

#. /paths/~1ngadmin~1apicalls~1{id}/get/responses/200/content/application~1json/schema/properties/requestMethod/description
msgid "Indicates the HTTP request method used to make the API call."
msgstr "表示发起 API 调用时使用的 HTTP 请求方法。"

#. /paths/~1ngadmin~1apicalls~1{id}/get/responses/200/content/application~1json/schema/properties/requestURL/description
msgid "The URL of the API call."
msgstr "API 调用的 URL。"

#. /paths/~1ngadmin~1apicalls~1{id}/get/responses/200/content/application~1json/schema/properties/responseHeaders/description
msgid ""
"HTTP headers that are returned in the response.  Each entry includes the "
"header name along with its value. Example: \"Qtl-Request-"
"Id:bf9bdb402ef4eaf5\""
msgstr ""
"响应中返回的 HTTP 头。每个条目包括头名称及其值。示例：\"Qtl-Request-"
"Id:bf9bdb402ef4eaf5\""

#. /paths/~1ngadmin~1apicalls~1{id}/get/responses/200/content/application~1json/schema/properties/responseTimestamp/description
msgid "RFC 3339 date indicating when the response was sent."
msgstr "RFC 3339 格式的日期，表示发送响应的时间。"

#. /paths/~1ngadmin~1apicalls~1{id}/get/responses/200/content/application~1json/schema/properties/responseCode/description
msgid "HTTP response status code for the API call."
msgstr "API 调用的 HTTP 响应状态码。"

#. /paths/~1ngadmin~1apicalls~1{id}/get/responses/200/content/application~1json/schema/properties/responseBody/description
msgid ""
"The response body returned by the API call, truncated to the first 1000 "
"bytes."
msgstr "API 调用返回的响应体，截取前 1000 个字节。"

#. /paths/~1ngadmin~1apicalls~1{id}/get/description
msgid ""
"Get details about an API call including its response status, request and "
"response headers, and caller's IP address."
msgstr ""
"获取 API 调用的详细信息，包括响应状态、请求头和响应头，以及调用方的 IP 地址。"

#. /paths/~1ngadmin~1apicalls~1counts/get/summary
msgid "Count API calls"
msgstr "统计 API 调用次数"

#. /paths/~1ngadmin~1apicalls~1counts/get/description
msgid ""
"Returns a count of API call records made by the calling customer. Supports "
"optional filtering by time window, request path prefix, and whether to "
"include calls made on behalf of the caller."
msgstr ""
"返回当前调用客户的 API 调用记录数。支持按时间窗口、请求路径前缀以及是否包含代"
"表调用方发起的调用进行可选筛选。"

#. /paths/~1ngadmin~1apicalls~1counts/get/parameters/0/description
msgid ""
"Start of the query time window, as an RFC 3339 UTC datetime (e.g. "
"`2019-03-01T10:00:00Z`). When omitted together with `enddate`, the window "
"defaults to the last 24 hours."
msgstr ""
"查询时间窗口的开始时间，采用 RFC 3339 UTC 日期时间格式（例如 "
"`2019-03-01T10:00:00Z`）。如果同时省略此参数和 `enddate`，时间窗口默认为最近 "
"24 小时。"

#. /paths/~1ngadmin~1apicalls~1counts/get/parameters/1/description
msgid ""
"End of the query time window, as an RFC 3339 UTC datetime (e.g. "
"`2019-03-31T10:00:00Z`). When omitted together with `startdate`, the window "
"defaults to the last 24 hours."
msgstr ""
"查询时间窗口的结束时间，采用 RFC 3339 UTC 日期时间格式（例如 "
"`2019-03-31T10:00:00Z`）。如果同时省略此参数和 `startdate`，时间窗口默认为最"
"近 24 小时。"

#. /paths/~1ngadmin~1apicalls~1counts/get/parameters/2/description
msgid ""
"Filter to API calls whose request path starts with this prefix. Case-"
"insensitive; normalized to lowercase with a leading `/`. Must start with one "
"of: `/cdn/`, `/ngadmin/`, `/hdt/`. A 400 error is returned for disallowed "
"prefixes."
msgstr ""
"仅统计请求路径以此前缀开头的 API 调用。不区分大小写，会被规范化为以 `/` 开头"
"的小写形式。必须以下列之一开头：`/cdn/`、`/ngadmin/`、`/hdt/`。如果前缀不被允"
"许，将返回 400 错误。"

#. /paths/~1ngadmin~1apicalls~1counts/get/parameters/3/description
msgid ""
"Scope toggle. `true` — only count calls made directly by the calling "
"customer. `false` — also include calls made on behalf of the calling "
"customer. "
msgstr ""
"范围开关。`true`：仅统计调用方客户直接发起的调用。`false`：同时包括代表调用方"
"客户发起的调用。"

#. /paths/~1ngadmin~1apicalls~1counts/get/responses/200/description
msgid ""
"A named data series containing the count of matching API calls. Currently "
"returns a single data point timestamped at `startdate`."
msgstr ""
"一个具名数据序列，包含匹配的 API 调用次数。目前仅返回一个时间戳为 "
"`startdate` 的数据点。"

#. /paths/~1ngadmin~1apicalls~1counts/get/responses/200/content/application~1json/schema/title
msgid "DataSeries"
msgstr "DataSeries"

#. /paths/~1ngadmin~1apicalls~1counts/get/responses/200/content/application~1json/schema/description
msgid "A named, unit-tagged data series."
msgstr "带有名称和单位标记的数据序列。"

#. /paths/~1ngadmin~1apicalls~1counts/get/responses/200/content/application~1json/schema/properties/dataName/description
msgid "Human-readable name of the data series."
msgstr "数据序列的可读名称。"

#. /paths/~1ngadmin~1apicalls~1counts/get/responses/200/content/application~1json/schema/properties/dataUnit/description
msgid "Unit of measurement for `data` values."
msgstr "`data` 值的计量单位。"

#. /paths/~1ngadmin~1apicalls~1counts/get/responses/200/content/application~1json/schema/properties/dataSeries/items/title
msgid "DataPoint"
msgstr "DataPoint"

#. /paths/~1ngadmin~1apicalls~1counts/get/responses/200/content/application~1json/schema/properties/dataSeries/items/description
msgid "A single data point with a timestamp and a numeric value."
msgstr "包含时间戳和数值的单个数据点。"

#. /paths/~1ngadmin~1apicalls~1counts/get/responses/200/content/application~1json/schema/properties/dataSeries/items/properties/timestamp/description
msgid ""
"RFC 3339 UTC timestamp. For the counts endpoint this is always the "
"`startdate` (start of the query window)."
msgstr ""
"RFC 3339 UTC 时间戳。对于计数接口，该值始终为 `startdate`（查询时间窗口的开始"
"时间）。"

#. /paths/~1ngadmin~1apicalls~1counts/get/responses/200/content/application~1json/schema/properties/dataSeries/items/properties/data/description
msgid "The count of API calls matching the query."
msgstr "与查询匹配的 API 调用次数。"

#. /paths/~1ngadmin~1apicalls~1counts/get/responses/400/description
msgid ""
"Bad Request — invalid date format, invalid path prefix, or missing/invalid "
"parameters."
msgstr "Bad Request：日期格式无效、路径前缀无效，或参数缺失/无效。"

#. /paths/~1cdn~1systemConfigs/get/summary
msgid "Get system configuration"
msgstr "获取系统配置"

#. /paths/~1cdn~1systemConfigs/get/responses/200/description
msgid "The response contains the system configuration."
msgstr "响应包含系统配置。"

#. /paths/~1cdn~1systemConfigs/get/responses/200/content/application~1json/schema/properties/baseDirectives/description
msgid "A list of Edge Logic directives that are available to everyone."
msgstr "所有人均可使用的边缘逻辑指令列表。"

#. /paths/~1cdn~1systemConfigs/get/responses/200/content/application~1json/schema/properties/advancedDirectives/description
msgid ""
"A list of advanced Edge Logic directives that can be enabled by contacting "
"our support team."
msgstr "高级边缘逻辑指令列表，可联系我们的技术支持团队开通。"

#. /paths/~1cdn~1systemConfigs/get/responses/200/content/application~1json/schema/properties/publishedPrice/description
msgid "Describes the price for traffic and requests."
msgstr "描述流量和请求的价格。"

#. /paths/~1cdn~1systemConfigs/get/responses/200/content/application~1json/schema/properties/publishedPrice/properties/perGB/description
msgid ""
"Describes the price for each gigabyte of traffic used  within each server "
"group."
msgstr "描述各节点组中每 GB 流量的价格。"

#. /paths/~1cdn~1systemConfigs/get/responses/200/content/application~1json/schema/properties/publishedPrice/properties/perGB/properties/standard/description
msgid ""
"Price in US dollars per gigabyte of traffic using the standard server group."
msgstr "使用 standard 节点组时每 GB 流量的价格（美元）。"

#. /paths/~1cdn~1systemConfigs/get/responses/200/content/application~1json/schema/properties/publishedPrice/properties/perGB/properties/premium/description
msgid ""
"Price in US dollars per gigabyte of traffic using the premium server group."
msgstr "使用 premium 节点组时每 GB 流量的价格（美元）。"

#. /paths/~1cdn~1systemConfigs/get/responses/200/content/application~1json/schema/properties/publishedPrice/properties/perGB/properties/deluxe/description
msgid ""
"Price in US dollars per gigabyte of traffic using the deluxe server group, "
"formerly referred to as \"premium+\""
msgstr ""
"使用 deluxe 节点组（以前称为 \"premium+\"）时每 GB 流量的价格（美元）。"

#. /paths/~1cdn~1systemConfigs/get/responses/200/content/application~1json/schema/properties/publishedPrice/properties/perGB/properties/ultra/description
msgid ""
"Price in US dollars per gigabyte of traffic using the ultra server group."
msgstr "使用 ultra 节点组时每 GB 流量的价格（美元）。"

#. /paths/~1cdn~1systemConfigs/get/responses/200/content/application~1json/schema/properties/publishedPrice/properties/perMHttpsReq/description
msgid "Price in US dollars of one million HTTPS requests."
msgstr "每一百万个 HTTPS 请求的价格（美元）。"

#. /paths/~1cdn~1systemConfigs/get/responses/200/content/application~1json/schema/properties/extraServicePorts/description
msgid ""
"This field lists nonstandard ports that can be used to handle HTTP and HTTPS "
"requests. If your website uses a nonstandard port which is not listed, "
"please contact our support team. You can specify one of these port numbers "
"in the <i>extraServicePorts</i> field of your property configuration."
msgstr ""
"此字段列出可用于处理 HTTP 和 HTTPS 请求的非标准端口。如果您的网站使用的非标准"
"端口未在列表中，请联系我们的技术支持团队。您可以在加速项目配置的 "
"<i>extraServicePorts</i> 字段中指定这些端口号之一。"

#. /paths/~1cdn~1systemConfigs/get/responses/200/content/application~1json/schema/properties/extraServicePorts/properties/http/description
msgid ""
"Specifies ports other than the default 80 which can be used to handle HTTP "
"requests."
msgstr "指定可用于处理 HTTP 请求的端口（默认端口 80 除外）。"

#. /paths/~1cdn~1systemConfigs/get/responses/200/content/application~1json/schema/properties/extraServicePorts/properties/https/description
msgid ""
"Specify ports other than the default 443 which can be used to handle HTTPS "
"requests."
msgstr "指定可用于处理 HTTPS 请求的端口（默认端口 443 除外）。"

#. /paths/~1cdn~1systemConfigs/get/responses/200/content/application~1json/schema/properties/advancedFeaures/description
msgid ""
"List of advanced features that can be enabled for customers via the service "
"quota API. \"realTimeLog\" is an advanced feature allowing a customer to "
"monitor requests from visitors to the content as they are received. "
"\"nearChina\" is an advanced feature allowing use of a special server group "
"to provide better performance to visitors in China for domains without ICP "
"Beian. \"originShield\" allows use of an extra layer of servers in front of "
"a property's origin servers. Please contact our support team if you require "
"an advanced feature."
msgstr ""
"可通过服务配额 API 为客户开通的高级功能列表。\"realTimeLog\" 是一项高级功能，"
"允许客户在收到访问者对内容的请求时实时监控这些请求。\"nearChina\" 是一项高级"
"功能，允许使用特殊的节点组，为未办理 ICP 备案的域名向中国境内的访问者提供更好"
"的性能。\"originShield\" 允许在加速项目的源站服务器前增加一层额外的服务器。如"
"果您需要使用高级功能，请联系我们的技术支持团队。"

#. /paths/~1cdn~1systemConfigs/get/responses/200/content/application~1json/schema/properties/oldestPropertyValidationTime/description
msgid ""
"RFC 3339 date indicating the oldest validated property that can be deployed. "
"Properties validated before this date must be re-validated before you can "
"deploy them. Example: \"2021-02-05T00:00:00Z\""
msgstr ""
"RFC 3339 格式的日期，表示可以部署的最早一次验证通过的加速项目。在此日期之前验"
"证的加速项目必须重新验证后才能部署。示例：\"2021-02-05T00:00:00Z\""

#. /paths/~1cdn~1systemConfigs/get/responses/200/content/application~1json/schema/properties/baseLbDirectives/description
msgid ""
"List of Edge Logic directives that can be used in the <i>loadBalancerLogic</"
"i> field of a property by everyone."
msgstr ""
"所有人都可以在加速项目的 <i>loadBalancerLogic</i> 字段中使用的 Edge Logic 指"
"令列表。"

#. /paths/~1cdn~1systemConfigs/get/responses/200/content/application~1json/schema/properties/advancedLbDirectives/description
msgid ""
"A list of advanced Edge Logic directives that can be enabled for use in the "
"<i>loadBalancerLogic</i> field of a property. If you require one that is not "
"enabled for your account, please contact our support team."
msgstr ""
"可启用并在加速项目的 <i>loadBalancerLogic</i> 字段中使用的高级 Edge Logic 指"
"令列表。如果您需要的指令尚未为您的账号启用，请联系我们的技术支持团队。"

#. /paths/~1cdn~1systemConfigs/get/responses/200/content/application~1json/schema/properties/supportedLanguages/description
msgid ""
"Indicates the languages that a customer can specify as preferred for "
"notifications.\n"
"<table>\n"
"<tr><th>Value</th><th>Language</th></tr>\n"
"<tr><td>en</td><td>English</td></tr>\n"
"<tr><td>cn</td><td>Chinese</td></tr>\n"
"<tr><td>jp</td><td>Japanese</td></tr>\n"
"<tr><td>kr</td><td>Korean</td></tr>\n"
"</table>"
msgstr ""
"表示客户可以指定为通知首选语言的语言。\n"
"<table>\n"
"<tr><th>值</th><th>语言</th></tr>\n"
"<tr><td>en</td><td>英语</td></tr>\n"
"<tr><td>cn</td><td>中文</td></tr>\n"
"<tr><td>jp</td><td>日语</td></tr>\n"
"<tr><td>kr</td><td>韩语</td></tr>\n"
"</table>"

#. /paths/~1cdn~1systemConfigs/get/description
msgid ""
"This API returns system configuration settings including supported [Edge "
"Logic directives](</docs/edge-logic/supported-directives>), advanced Edge "
"Logic directives, the default pricing for traffic, and nonstandard ports "
"that can handle HTTP and HTTPS requests. Please note that your account may "
"not have access to the advanced Edge Logic directives or features. Please "
"contact our support team if you require access to a particular directive, "
"feature, or port that is not listed."
msgstr ""
"此 API 返回系统配置，包括支持的 [Edge Logic 指令](</docs/edge-logic/"
"supported-directives>)、高级 Edge Logic 指令、流量的默认价格，以及可处理 "
"HTTP 和 HTTPS 请求的非标准端口。请注意，您的账号可能无权使用高级 Edge Logic "
"指令或功能。如果您需要使用未列出的某个指令、功能或端口，请联系我们的技术支持"
"团队。"

#. /paths/~1cdn~1serviceQuotas/post/summary
msgid "Create a service quota for a customer"
msgstr "为客户创建服务配额"

#. /paths/~1cdn~1serviceQuotas/post/responses/201/description
msgid ""
"The service quota was successfully created. A Location header will contain a "
"URL to the newly created service quota."
msgstr "服务配额已成功创建。Location 头中包含指向新建服务配额的 URL。"

#. /paths/~1cdn~1serviceQuotas/post/responses/201/headers/Location/description
msgid ""
"URL to the new service quota. The URL follows this format: https://ngapi."
"{{siteDomain}}/cdn/serviceQuotas/{serviceQuotaId} where {serviceQuotaId} "
"represents the ID of the newly created service quota. If you would like to "
"get the service quota ID, simply extract the last portion of the path and "
"ignore the rest. The ID can be used to query, update, or delete the service "
"quota."
msgstr ""
"新服务配额的 URL。URL 的格式为：https://ngapi.{{siteDomain}}/cdn/"
"serviceQuotas/{serviceQuotaId}，其中 {serviceQuotaId} 表示新建服务配额的 ID。"
"如果您想获取服务配额 ID，只需提取路径的最后一部分，忽略其余部分即可。该 ID 可"
"用于查询、修改或删除该服务配额。"

#. /paths/~1cdn~1serviceQuotas/post/description
msgid ""
"A reseller can use this API to define CDN Pro service quotas for a child "
"customer. The child customer cannot have quota levels greater than those of "
"the reseller. "
msgstr ""
"代理商可以使用此 API 为子客户定义 CDN Pro 服务配额。子客户的配额不能高于代理"
"商的配额。"

#. /paths/~1cdn~1serviceQuotas/post/requestBody/content/application~1json/schema/properties/customerId/description
msgid "ID of the customer for which to create the service quota."
msgstr "要为其创建服务配额的客户的 ID。"

#. /paths/~1cdn~1serviceQuotas/post/requestBody/content/application~1json/schema/properties/status/description
#. /paths/~1cdn~1serviceQuotas~1{serviceQuotaId}/get/responses/200/content/application~1json/schema/properties/status/description
#. /paths/~1cdn~1serviceQuotas~1{serviceQuotaId}/patch/requestBody/content/application~1json/schema/properties/status/description
#. (+3 more)
msgid ""
"Indicates the status of the customer's access to the CDN Pro product.  An "
"<i>active</i> customer has full access. A <i>suspended</i> customer no "
"longer has access but may return to use the service. A <i>trial</i> customer "
"is one with trial settings which may be more limited than those of a "
"customer with the <i>active</i> status. A <i>terminated</i> customer no "
"longer has access."
msgstr ""
"表示客户使用 CDN Pro 产品的权限状态。<i>active</i> 客户拥有完整的使用权限。"
"<i>suspended</i> 客户不再拥有使用权限，但之后可能恢复使用该服务。<i>trial</"
"i> 客户采用试用设置，其限制可能比 <i>active</i> 状态的客户更多。"
"<i>terminated</i> 客户不再拥有使用权限。"

#. /paths/~1cdn~1serviceQuotas/post/requestBody/content/application~1json/schema/properties/contractId/description
msgid "ID representing the contract, used for billing."
msgstr "表示合同的 ID，用于计费。"

#. /paths/~1cdn~1serviceQuotas/post/requestBody/content/application~1json/schema/properties/accountManagerEmail/description
#. /paths/~1cdn~1serviceQuotas~1{serviceQuotaId}/get/responses/200/content/application~1json/schema/properties/accountManagerEmail/description
#. /paths/~1cdn~1serviceQuotas~1{serviceQuotaId}/patch/requestBody/content/application~1json/schema/properties/accountManagerEmail/description
#. (+3 more)
msgid "An email address representing the account manager."
msgstr "客户经理的电子邮件地址。"

#. /paths/~1cdn~1serviceQuotas/post/requestBody/content/application~1json/schema/properties/trialDeadline/description
msgid ""
"A date in RFC 3339 format indicating when the trial expires. This field is "
"required if the <i>status</i> field's value is <i>trial</i>. "
msgstr ""
"RFC 3339 格式的日期，表示试用到期的时间。如果 <i>status</i> 字段的值为 "
"<i>trial</i>，则此字段为必填项。"

#. /paths/~1cdn~1serviceQuotas/post/requestBody/content/application~1json/schema/properties/usageLimitDays/description
msgid ""
"This setting applies to trial customers. It is used to limit traffic use. It "
"represents the number of days over which the traffic amount designated by "
"the <i>usageLimitDollar</i> field can be used. For example, a value of 90 "
"for <i>usageLimitDays</i> and 50 for <i>usageLimitDollar</i> means the "
"customer can use up to $50 worth of total traffic over a 90 day period. A "
"value of 0 means there is no limit on the customer."
msgstr ""
"此设置适用于试用客户，用于限制流量使用。它表示可以使用 <i>usageLimitDollar</"
"i> 字段所指定流量额度的天数。例如，<i>usageLimitDays</i> 的值为 90、"
"<i>usageLimitDollar</i> 的值为 50，表示客户在 90 天内最多可以使用价值 50 美元"
"的总流量。值为 0 表示不对该客户设限。"

#. /paths/~1cdn~1serviceQuotas/post/requestBody/content/application~1json/schema/properties/usageLimitDollar/description
msgid ""
"This setting applies to trial customers. It represents the amount of traffic "
"valued in US dollars that is permitted to be used over a period of time  set "
"by the <i>usageLimitDays</i> field. For example, a value of 90 for "
"<i>usageLimitDays</i> and 50 for <i>usageLimitDollar</i> means the customer "
"can use up to $50 worth of total traffic over a 90 day period. The dollar "
"value is based on CDN Pro's default pricing. A value of 0 means there is no "
"limit on the customer."
msgstr ""
"此设置适用于试用客户。它表示在 <i>usageLimitDays</i> 字段设定的时间段内允许使"
"用的流量额度（以美元计价）。例如，<i>usageLimitDays</i> 的值为 90、"
"<i>usageLimitDollar</i> 的值为 50，表示客户在 90 天内最多可以使用价值 50 美元"
"的总流量。美元金额基于 CDN Pro 的默认定价。值为 0 表示不对该客户设限。"

#. /paths/~1cdn~1serviceQuotas/post/requestBody/content/application~1json/schema/properties/allowDeploymentInChina/description
#. /paths/~1cdn~1serviceQuotas~1{serviceQuotaId}/patch/requestBody/content/application~1json/schema/properties/allowDeploymentInChina/description
#. /paths/~1cdn~1serviceQuotas~1customer~1{customerId}/patch/requestBody/content/application~1json/schema/properties/allowDeploymentInChina/description
msgid ""
"Indicates whether deployment to PoPs in mainland China is permitted. An ICP "
"Beian license is required for web content to be hosted on servers within "
"China. A reseller must collect and verify a child customer's name, address, "
"phone, responsible person, and China business information before enabling "
"deployment to China. Those settings are specified when <a href=\"/apidocs/"
"customer-management/post-ngadmin-customers\">creating</a> or <a href=\"/"
"apidocs/customer-management/patch-ngadmin-customers-id\">updating</a> a "
"customer."
msgstr ""
"表示是否允许部署到中国大陆的 PoP。在中国境内的服务器上托管网页内容需要 ICP 备"
"案。代理商在为子客户启用中国境内部署之前，必须收集并核实子客户的名称、地址、"
"电话、负责人以及中国业务信息。这些信息在<a href=\"/apidocs/customer-"
"management/post-ngadmin-customers\">创建</a>或<a href=\"/apidocs/customer-"
"management/patch-ngadmin-customers-id\">修改</a>客户时指定。"

#. /paths/~1cdn~1serviceQuotas/post/requestBody/content/application~1json/schema/properties/hostnameLimit/description
msgid "Maximum number of hostnames allowed in production."
msgstr "生产环境中允许的加速域名的最大数量。"

#. /paths/~1cdn~1serviceQuotas/post/requestBody/content/application~1json/schema/properties/edgeHostnameLimit/description
#. /paths/~1cdn~1serviceQuotas~1{serviceQuotaId}/get/responses/200/content/application~1json/schema/properties/edgeHostnameLimit/description
#. /paths/~1cdn~1serviceQuotas~1{serviceQuotaId}/patch/requestBody/content/application~1json/schema/properties/edgeHostnameLimit/description
#. (+3 more)
msgid "Maximum number of edge hostnames that can be created."
msgstr "可以创建的调度域名的最大数量。"

#. /paths/~1cdn~1serviceQuotas/post/requestBody/content/application~1json/schema/properties/filePurgeQuotaInStaging/description
#. /paths/~1cdn~1serviceQuotas~1{serviceQuotaId}/get/responses/200/content/application~1json/schema/properties/filePurgeQuotaInStaging/description
#. /paths/~1cdn~1serviceQuotas~1{serviceQuotaId}/patch/requestBody/content/application~1json/schema/properties/filePurgeQuotaInStaging/description
#. (+3 more)
msgid ""
"Maximum number of file purges allowed in the staging environment in a 24-"
"hour rolling window."
msgstr "在 24 小时滚动窗口内，演练环境中允许的文件刷新的最大次数。"

#. /paths/~1cdn~1serviceQuotas/post/requestBody/content/application~1json/schema/properties/dirPurgeQuotaInStaging/description
#. /paths/~1cdn~1serviceQuotas~1{serviceQuotaId}/get/responses/200/content/application~1json/schema/properties/dirPurgeQuotaInStaging/description
#. /paths/~1cdn~1serviceQuotas~1{serviceQuotaId}/patch/requestBody/content/application~1json/schema/properties/dirPurgeQuotaInStaging/description
#. (+3 more)
msgid ""
"Maximum number of directory purges allowed in the staging environment in a "
"24-hour rolling window. This limit is also used as the maximum number of "
"regular expression purges allowed in staging."
msgstr ""
"在 24 小时滚动窗口内，演练环境中允许的目录刷新的最大次数。此限制同时也作为演"
"练环境中允许的正则表达式刷新的最大次数。"

#. /paths/~1cdn~1serviceQuotas/post/requestBody/content/application~1json/schema/properties/filePurgeQuotaInProduction/description
#. /paths/~1cdn~1serviceQuotas~1{serviceQuotaId}/get/responses/200/content/application~1json/schema/properties/filePurgeQuotaInProduction/description
#. /paths/~1cdn~1serviceQuotas~1{serviceQuotaId}/patch/requestBody/content/application~1json/schema/properties/filePurgeQuotaInProduction/description
#. (+3 more)
msgid ""
"Maximum number of file purges allowed in the production environment in a 24-"
"hour rolling window."
msgstr "在 24 小时滚动窗口内，生产环境中允许的文件刷新的最大次数。"

#. /paths/~1cdn~1serviceQuotas/post/requestBody/content/application~1json/schema/properties/dirPurgeQuotaInProduction/description
#. /paths/~1cdn~1serviceQuotas~1{serviceQuotaId}/get/responses/200/content/application~1json/schema/properties/dirPurgeQuotaInProduction/description
#. /paths/~1cdn~1serviceQuotas~1{serviceQuotaId}/patch/requestBody/content/application~1json/schema/properties/dirPurgeQuotaInProduction/description
#. (+3 more)
msgid ""
"Maximum number of directory purges allowed in the production environment in "
"a 24-hour rolling window. This limit is also used as the maximum number of "
"regular expression purges allowed in production."
msgstr ""
"在 24 小时滚动窗口内，生产环境中允许的目录刷新的最大次数。此限制同时也作为生"
"产环境中允许的正则表达式刷新的最大次数。"

#. /paths/~1cdn~1serviceQuotas/post/requestBody/content/application~1json/schema/properties/prefetchQuota/description
#. /paths/~1cdn~1serviceQuotas~1{serviceQuotaId}/get/responses/200/content/application~1json/schema/properties/prefetchQuota/description
#. /paths/~1cdn~1serviceQuotas~1{serviceQuotaId}/patch/requestBody/content/application~1json/schema/properties/prefetchQuota/description
#. (+3 more)
msgid "Maximum number of prefetch requests in a 24-hour window."
msgstr "24 小时窗口内预取请求的最大数量。"

#. /paths/~1cdn~1serviceQuotas/post/requestBody/content/application~1json/schema/properties/propertyLimit/description
msgid "Maximum number of properties that can be created."
msgstr "可以创建的加速项目的最大数量。"

#. /paths/~1cdn~1serviceQuotas/post/requestBody/content/application~1json/schema/properties/certificateLimit/description
#. /paths/~1cdn~1serviceQuotas~1{serviceQuotaId}/get/responses/200/content/application~1json/schema/properties/certificateLimit/description
