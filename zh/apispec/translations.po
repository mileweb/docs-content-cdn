#. (+3 more)
msgid "A domain to use for edge hostnames."
msgstr ""

#. /paths/~1cdn~1serviceQuotas/post/requestBody/content/application~1json/schema/properties/edgeHostnameZones/items/properties/hasBeian/description
#. /paths/~1cdn~1serviceQuotas~1{serviceQuotaId}/get/responses/200/content/application~1json/schema/properties/edgeHostnameZones/items/properties/hasBeian/description
