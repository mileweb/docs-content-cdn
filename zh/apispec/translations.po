"<tr><td>%cachestate</td><td>HIT、MISS 或 REVALIDATE</td></tr>\n"
"<tr><td>%cltip</td><td>客户端 IP 地址</td></tr>\n"
"<tr><td>%cltisp</td><td>客户端运营商</td></tr>\n"
