msgstr ""

#. /paths/~1ngadmin~1contacts/post/responses/201/description
msgid ""
"The user account was successfully created. The Location header will contain "
"a URL to the new account. Example:<code>Location: https://ngapi."
"{siteDomain}}/ngadmin/contacts/123</code>"
msgstr ""

#. /paths/~1ngadmin~1contacts/post/responses/201/headers/Location/description
